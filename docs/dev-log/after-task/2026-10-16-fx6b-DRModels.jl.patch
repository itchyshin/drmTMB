+# Parametric bootstrap null for lrtest / anova (DRModels #1116 / #1118,
+# twin of drmTMB FX6b / #1559 / #1560).
+#
+# Red-proof: on pin f71b292 plus the FX6 warning patch, `test = :bootstrap`
+# is an unused keyword and this file fails. After FX6b, both verbs simulate
+# from the reduced fit and return nsim, seed, and failed.
+
+using DRModels
+using Test, Random
+import Distributions
+
+function _nb2_null_data(; n = 80)
+    Random.seed!(20261017000 - 19000000000)
+    x = randn(n)
+    y = Float64.(rand.(Distributions.Poisson.(exp.(0.4 .+ 0.3 .* x))))
+    return (; y, x)
+end
+
+@testset "lrtest test = :bootstrap returns nsim, seed, failed (#1116)" begin
+    Random.seed!(1)
+    n = 40
+    x = randn(n)
+    y = 0.2 .+ 0.6 .* x .+ randn(n)
+    data = (; y, x)
+    m0 = drm(bf(@formula(y ~ 1), @formula(sigma ~ 1)), Gaussian(); data)
+    m1 = drm(bf(@formula(y ~ 1 + x), @formula(sigma ~ 1)), Gaussian(); data)
+
+    t = lrtest(m0, m1; test = :bootstrap, nsim = 19, seed = 20261016, data = data)
+    @test 0 <= t.pvalue <= 1
+    @test t.nsim == 19
+    @test t.seed == 20261016
+    @test t.failed isa Integer
+    @test 0 <= t.failed <= 19
+    @test anova(m0, m1; test = :bootstrap, nsim = 19, seed = 20261016, data = data) == t
+    @test_throws ArgumentError lrtest(m0, m1; test = :bootstrap, nsim = 19, seed = 1)
+end
+
+@testset "lrtest bootstrap on Poisson vs NegBinomial2 (#1116)" begin
+    data = _nb2_null_data()
+    pois = drm(bf(@formula(y ~ 1 + x)), DRModels.Poisson(); data, se = false)
+    nb = drm(bf(@formula(y ~ 1 + x), @formula(sigma ~ 1)), NegBinomial2();
+             data, se = false)
+    t = @test_logs (:warn, r"(?i)boundary|sigma|bootstrap") match_mode = :any begin
+        lrtest(pois, nb; test = :bootstrap, nsim = 19, seed = 7, data = data)
+    end
+    @test t.nsim == 19
+    @test t.seed == 7
+    @test t.failed isa Integer
+    @test 0 <= t.pvalue <= 1
+end
