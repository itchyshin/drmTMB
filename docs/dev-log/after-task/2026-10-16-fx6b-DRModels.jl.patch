+function _lrt_test_kind(test)
+    test === nothing && return :default
+    key = test isa Symbol ? test : Symbol(lowercase(string(test)))
+    key in (:chisq, :lrt, :default, :chi_square) && return :default
+    key in (:bootstrap, :parametric, :parametric_bootstrap) && return :bootstrap
+    throw(ArgumentError("lrtest: `test` must be :chisq, :lrt, :bootstrap, or omitted"))
+end
+
+function _replace_response(data, response::Symbol, y)
+    data isa NamedTuple || throw(ArgumentError(
+        "lrtest: test = :bootstrap needs `data` as a NamedTuple"))
+    return merge(data, NamedTuple{(response,)}((y,)))
+end
+
+function _lrt_bootstrap(reduced::DrmFit, full::DrmFit, statistic;
+                        nsim::Integer, seed, data)
+    data === nothing && throw(ArgumentError(
+        "lrtest: test = :bootstrap needs the original `data` table " *
+        "(a DrmFit does not retain it)."))
+    nsim >= 1 || throw(ArgumentError("lrtest: `nsim` must be a positive whole number"))
+    reduced.formula isa DrmFormula || throw(ArgumentError(
+        "lrtest: test = :bootstrap currently supports univariate DrmFormula fits"))
+    rng = seed === nothing ? default_rng() : MersenneTwister(Int(seed))
+    resp = reduced.formula.response
+    Y = simulate(reduced; nsim = nsim, rng = rng)
+    n_ok = 0
+    n_ge = 0
+    failed = 0
+    for s in 1:nsim
+        ystar = nsim == 1 ? Y : view(Y, :, s)
+        data_s = _replace_response(data, resp, collect(ystar))
+        red_s = try
+            drm(reduced.formula, reduced.family; data = data_s)
+        catch
+            failed += 1
+            continue
+        end
+        full_s = try
+            drm(full.formula, full.family; data = data_s)
+        catch
+            failed += 1
+            continue
+        end
+        if !red_s.converged || !full_s.converged
+            failed += 1
+            continue
+        end
+        llr = loglik(red_s)
+        llf = loglik(full_s)
+        if !(isfinite(llr) && isfinite(llf))
+            failed += 1
+            continue
+        end
+        n_ok += 1
+        n_ge += Int(2 * (llf - llr) >= statistic)
+    end
+    n_ok < 1 && throw(ArgumentError(
+        "lrtest: parametric bootstrap — every one of $nsim refit pairs failed"))
+    return (; pvalue = (1 + n_ge) / (1 + n_ok), nsim = Int(nsim),
+            seed = seed, failed = failed)
+end
