diff --git a/src/separation.jl b/src/separation.jl
index 59bd314..b6292c7 100644
--- a/src/separation.jl
+++ b/src/separation.jl
@@ -310,3 +310,32 @@ function _separation_guard(X, s, ntr, θ̂, V, μ̂, names; maxiter = nothing)
     end
     return V2
 end
+
+# FX3 / #1109: Poisson / NB2 fixed-effect MLE existence. The binomial cone
+# with s = 1{y > 0} and ntr = 1 + s (Haberman 1974; Santos Silva and Tenreyro
+# 2010). Warns, names the coefficients, and reports SE = Inf. The three-valued
+# status (FX3b) then reads `:degenerate`.
+function _count_mle_existence_guard(X, y, V, names; family::AbstractString = "Poisson")
+    s = Float64.(y .> 0)
+    ntr = 1 .+ s
+    det = _detect_separation(X, s, ntr)
+    det.separated || return V, false
+    flagged = det.flagged
+    quiet = get(task_local_storage(), :drm_quiet_boundary, false)
+    quiet || @warn """
+          $family fixed-effect maximum-likelihood estimate does not exist
+          (all-zero counts, or positives only on a face of the covariate cone;
+          Haberman 1974; Santos Silva and Tenreyro 2010). Reported coefficients
+          are an arbitrary optimiser stop. Affected terms have SE = Inf.
+          """ flagged_coefficients = (isempty(flagged) ? String[] : String.(names[flagged]))
+    V2 = copy(V)
+    p = size(V2, 1)
+    js = isempty(flagged) ? collect(1:p) : flagged
+    for j in js
+        (1 <= j <= p) || continue
+        V2[j, :] .= NaN
+        V2[:, j] .= NaN
+        V2[j, j] = Inf
+    end
+    return V2, true
+end
