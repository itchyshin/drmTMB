+# FX3b twin contract: convergence_status ∈ {converged, boundary, degenerate}.
+# is_converged / converged are true only for :converged.
+# Poisson all-zero is the #1109 / FX3 red-proof.
+
+using Test
+using Random
+using DRModels
+using StatsModels: @formula
+
+@testset "twin numeric constants" begin
+    @test DRModels._TWIN_RANK_TOL == 1e-8
+    @test DRModels._TWIN_INFLATED_SE_FLOOR == 50.0
+    @test DRModels._TWIN_INFLATED_SE_RATIO == 1000.0
+    @test DRModels._TWIN_RE_SD_BOUNDARY == 1e-4
+    @test DRModels._TWIN_RHO12_BOUNDARY == 0.98
+    @test DRModels._TWIN_SENTINEL_LOGLIK == -1e15
+    @test !DRModels._twin_inflated_se([0.1, 0.2, 0.15])
+    @test DRModels._twin_inflated_se([0.1, 0.2, 500.0])
+    @test !DRModels._twin_inflated_se([80.0, 90.0, 100.0])
+    @test DRModels._twin_inflated_se([80.0, 90.0, 8e5])
+end
+
+@testset "ordinary Gaussian is converged" begin
+    rng = MersenneTwister(20261016)
+    x = randn(rng, 40)
