diff --git a/src/convergence_status.jl b/src/convergence_status.jl
new file mode 100644
index 0000000..5c7737d
--- /dev/null
+++ b/src/convergence_status.jl
@@ -0,0 +1,107 @@
+# Twin contract: three-valued convergence_status (FX3b / drmTMB #1554).
+# Numeric cuts MUST stay identical to drmTMB R/check.R and
+# docs/design/278-twin-convergence-status.md in itchyshin/drmTMB.
+
+using LinearAlgebra: isposdef, Symmetric
+using Statistics: median
+
+const _TWIN_RANK_TOL = 1e-8
+const _TWIN_INFLATED_SE_FLOOR = 50.0
+const _TWIN_INFLATED_SE_RATIO = 1000.0
+const _TWIN_RE_SD_BOUNDARY = 1e-4
+const _TWIN_RHO12_BOUNDARY = 0.98
+const _TWIN_SENTINEL_LOGLIK = -1e15
+
+function _twin_se(V::AbstractMatrix)
+    n = size(V, 1)
+    n == 0 && return Float64[]
+    se = fill(NaN, n)
+    @inbounds for j in 1:n
+        v = V[j, j]
+        if isfinite(v) && v >= 0
+            se[j] = sqrt(v)
+        end
+    end
+    return se
+end
+
+function _twin_vcov_pd(V::AbstractMatrix)
+    (size(V, 1) == 0 || size(V, 1) != size(V, 2)) && return false
+    all(isfinite, V) || return false
+    return isposdef(Symmetric(Matrix{Float64}(V)))
+end
+
+function _twin_inflated_se(se::AbstractVector)
+    finite = [s for s in se if isfinite(s)]
+    isempty(finite) && return false
+    reference = [s for s in finite if s < _TWIN_INFLATED_SE_FLOOR]
+    median_se = isempty(reference) ? minimum(finite) : median(reference)
+    return any(s -> isfinite(s) && s >= _TWIN_INFLATED_SE_FLOOR &&
+        s >= _TWIN_INFLATED_SE_RATIO * median_se, se)
+end
+
+function _twin_re_sds(fit::DrmFit)
+    try
+        return collect(values(re_sd(fit)))
+    catch
+        return Float64[]
+    end
+end
+
+function _twin_rho12(fit::DrmFit)
+    try
+        r = rho12(fit)
+        return r isa AbstractVector ? collect(Float64, r) : Float64[Float64(r)]
+    catch
+        return Float64[]
+    end
+end
+
+function _count_mle_nonexistent(fit::DrmFit)
+    haskey(fit.scales, :__mle_nonexistent) && return true
+    (fit.family isa Poisson || fit.family isa NegBinomial2) || return false
+    y = get(fit.obs, :mu, nothing)
+    y isa AbstractVector || return false
+    return !isempty(y) && all(iszero, y)
+end
+
+"""
+    convergence_status(fit::DrmFit) -> Symbol
+
+One of `:converged`, `:boundary`, or `:degenerate`. Identical numeric
+predicates to drmTMB (`docs/design/278-twin-convergence-status.md`).
+`is_converged(fit)` and `converged(fit)` are `true` only for `:converged`.
+The raw optimiser flag remains `fit.converged`.
+"""
+function convergence_status(fit::DrmFit)
+    if !fit.converged || !isfinite(fit.loglik) || fit.loglik <= _TWIN_SENTINEL_LOGLIK
+        return :degenerate
+    end
+    if _count_mle_nonexistent(fit) || !_nondegenerate_fit(fit)
+        return :degenerate
+    end
+    V = fit.vcov
+    se = _twin_se(V)
+    if !_twin_vcov_pd(V) || isempty(se) || !all(isfinite, se) || _twin_inflated_se(se)
+        return :degenerate
+    end
+    sds = _twin_re_sds(fit)
+    rhos = _twin_rho12(fit)
+    at_boundary = any(s -> isfinite(s) && s < _TWIN_RE_SD_BOUNDARY, sds) ||
+        any(r -> isfinite(r) && abs(r) > _TWIN_RHO12_BOUNDARY, rhos)
+    return at_boundary ? :boundary : :converged
+end
+
+"""
+    is_converged(fit::DrmFit) -> Bool
+
+`true` exactly when `convergence_status(fit) === :converged`.
+"""
+is_converged(fit::DrmFit) = convergence_status(fit) === :converged
+
+"""
+    converged(fit::DrmFit) -> Bool
+
+Alias for [`is_converged`](@ref). The raw optimiser flag is `fit.converged`.
+"""
+converged(fit::DrmFit) = is_converged(fit)
