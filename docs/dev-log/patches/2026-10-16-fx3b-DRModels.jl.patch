+# FX3 / #1109: Poisson MLE-existence guard (all-zero and extreme-x).
+
+using Test
+using DRModels
+using StatsModels: @formula
+
+@testset "Poisson cone unit: all-zero, extreme-x, overlap" begin
+    X = hcat(ones(6), [-3.0, -2, -1, 1, 2, 3])
+    d0 = DRModels._detect_separation(X, zeros(6), ones(6))
+    @test d0.separated
+    yp = [0.0, 0, 0, 0, 0, 2]
+    s = Float64.(yp .> 0)
+    dp = DRModels._detect_separation(X, s, 1 .+ s)
+    @test dp.separated
+    yok = [0.0, 1, 0, 2, 1, 3]
+    s = Float64.(yok .> 0)
+    dok = DRModels._detect_separation(X, s, 1 .+ s)
+    @test !dok.separated
+end
