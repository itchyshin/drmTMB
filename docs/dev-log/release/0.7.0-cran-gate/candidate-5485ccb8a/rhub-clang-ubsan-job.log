2026-08-18T21:56:04.9427731Z     if (!missing(family)) {
2026-08-18T21:56:04.9427964Z         if (length(family) == 4L) {
2026-08-18T21:56:04.9428231Z             family <- c(family, "Symbol.afm")
2026-08-18T21:56:04.9428491Z         }
2026-08-18T21:56:04.9428688Z         else if (length(family) == 5L) {
2026-08-18T21:56:04.9428934Z         }
2026-08-18T21:56:04.9429116Z         else if (length(family) == 1L) {
2026-08-18T21:56:04.9429381Z             pf <- pdfFonts(family)[[1L]]
2026-08-18T21:56:04.9429646Z             if (is.null(pf)) 
2026-08-18T21:56:04.9429924Z                 stop(gettextf("unknown family '%s'", family), 
2026-08-18T21:56:04.9430224Z                   domain = NA)
2026-08-18T21:56:04.9430458Z             matchFont(pf, old$encoding)
2026-08-18T21:56:04.9430696Z         }
2026-08-18T21:56:04.9430893Z         else stop("invalid 'family' argument")
2026-08-18T21:56:04.9431166Z         old$family <- family
2026-08-18T21:56:04.9431382Z     }
2026-08-18T21:56:04.9431566Z     version <- old$version
2026-08-18T21:56:04.9431845Z     versions <- c("1.1", "1.2", "1.3", "1.4", "1.5", "1.6", "1.7", 
