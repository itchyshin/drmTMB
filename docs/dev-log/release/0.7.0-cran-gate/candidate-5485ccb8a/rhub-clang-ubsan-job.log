2026-08-18T22:20:16.4364818Z > ### Name: random_effect_scale_formulas
2026-08-18T22:20:16.4364928Z > ### Title: Random-effect scale formula syntax
2026-08-18T22:20:16.4365109Z > ### Aliases: random_effect_scale_formulas sd sd1 sd2 sd_phylo sd_phylo1
2026-08-18T22:20:16.4365184Z > ###   sd_phylo2
2026-08-18T22:20:16.4365257Z > 
2026-08-18T22:20:16.4365343Z > ### ** Examples
2026-08-18T22:20:16.4365412Z > 
2026-08-18T22:20:16.4365525Z > bf(y ~ x + (1 | id), sigma ~ z, sd(id) ~ habitat)
2026-08-18T22:20:16.4365602Z <drm_formula>
2026-08-18T22:20:16.4365682Z y ~ x + (1 | id)
2026-08-18T22:20:16.4365757Z sigma ~ z
2026-08-18T22:20:16.4365836Z sd(id) ~ habitat
2026-08-18T22:20:16.4365911Z > 
2026-08-18T22:20:16.4365982Z > bf(
2026-08-18T22:20:16.4366193Z +   mu1 = y1 ~ x + (1 | p | id),
2026-08-18T22:20:16.4366279Z +   mu2 = y2 ~ x + (1 | p | id),
2026-08-18T22:20:16.4366362Z +   sd1(id) ~ habitat,
2026-08-18T22:20:16.4366438Z +   sd2(id) ~ habitat,
2026-08-18T22:20:16.4366517Z +   rho12 = ~ x
2026-08-18T22:20:16.4366592Z + )
2026-08-18T22:20:16.4366666Z <drm_formula>
2026-08-18T22:20:16.4366750Z mu1 = y1 ~ x + (1 | p | id)
2026-08-18T22:20:16.4366827Z mu2 = y2 ~ x + (1 | p | id)
2026-08-18T22:20:16.4366909Z sd1(id) ~ habitat
2026-08-18T22:20:16.4366988Z sd2(id) ~ habitat
2026-08-18T22:20:16.4367060Z rho12 = ~x
2026-08-18T22:20:16.4367135Z > 
2026-08-18T22:20:16.4367208Z > bf(
2026-08-18T22:20:16.4367315Z +   y ~ x + phylo(1 | species, tree = tree),
2026-08-18T22:20:16.4367429Z +   sd(species, level = "phylogenetic") ~ ecology
2026-08-18T22:20:16.4367505Z + )
2026-08-18T22:20:16.4367583Z <drm_formula>
2026-08-18T22:20:16.4367679Z y ~ x + phylo(1 | species, tree = tree)
2026-08-18T22:20:16.4367791Z sd(species, level = "phylogenetic") ~ ecology
2026-08-18T22:20:16.4367863Z > 
