2026-08-18T22:20:16.3962664Z + )
2026-08-18T22:20:16.3962839Z > assoc <- associate_pairs(
2026-08-18T22:20:16.3963338Z +   gaussian_fit, binary_fit,
2026-08-18T22:20:16.3963670Z +   kernel = latent_normal(), association = ~ 1
2026-08-18T22:20:16.3964095Z + )
2026-08-18T22:20:16.3964448Z > association(assoc)
