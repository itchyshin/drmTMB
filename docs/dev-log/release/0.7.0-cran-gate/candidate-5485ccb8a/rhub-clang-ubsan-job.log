2026-08-18T22:20:16.4182154Z > ### ** Examples
2026-08-18T22:20:16.4182343Z > 
2026-08-18T22:20:16.4182511Z > set.seed(20260525)
2026-08-18T22:20:16.4182715Z > dat <- data.frame(
2026-08-18T22:20:16.4183227Z +   y = 0.2 + 0.6 * seq(-1, 1, length.out = 24) + rnorm(24, sd = 0.5),
