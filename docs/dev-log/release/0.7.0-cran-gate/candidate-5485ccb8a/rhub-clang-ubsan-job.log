2026-08-18T22:20:16.4187912Z 
2026-08-18T22:20:16.4187990Z $sigma
2026-08-18T22:20:16.4188169Z (Intercept)           x 
2026-08-18T22:20:16.4188376Z -0.63277067 -0.01385506 
2026-08-18T22:20:16.4188506Z 
2026-08-18T22:20:16.4188583Z > names(coef(fit))
2026-08-18T22:20:16.4188776Z [1] "mu"    "sigma"
2026-08-18T22:20:16.4188990Z > identical(coef(fit), fixef(fit))
2026-08-18T22:20:16.4189359Z [1] TRUE
