2026-08-18T22:20:16.4371907Z > 
2026-08-18T22:20:16.4372094Z > # Fitted: a genomic relatedness matrix for among-line genetic variance.
2026-08-18T22:20:16.4372229Z > bf(seed_mass ~ temperature + relmat(1 | line, K = G),
2026-08-18T22:20:16.4372312Z +   sigma ~ temperature
2026-08-18T22:20:16.4372386Z + )
2026-08-18T22:20:16.4372460Z <drm_formula>
2026-08-18T22:20:16.4372579Z seed_mass ~ temperature + relmat(1 | line, K = G)
2026-08-18T22:20:16.4372663Z sigma ~ temperature
2026-08-18T22:20:16.4372738Z > 
2026-08-18T22:20:16.4373162Z > # Fitted: a user-built sparse precision for another dependence structure.
2026-08-18T22:20:16.4373306Z > bf(growth ~ treatment + relmat(1 | plot, Q = Q_plot),
2026-08-18T22:20:16.4373390Z +   sigma ~ treatment
2026-08-18T22:20:16.4373462Z + )
2026-08-18T22:20:16.4373666Z <drm_formula>
2026-08-18T22:20:16.4373786Z growth ~ treatment + relmat(1 | plot, Q = Q_plot)
2026-08-18T22:20:16.4373861Z sigma ~ treatment
