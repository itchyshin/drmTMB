2026-08-18T22:20:16.4324078Z +     estimate = 0.55 + 0.08 * x,
2026-08-18T22:20:16.4324167Z +     conf.low = 0.47 + 0.08 * x,
2026-08-18T22:20:16.4324251Z +     conf.high = 0.63 + 0.08 * x,
2026-08-18T22:20:16.4324337Z +     conf.status = "wald",
2026-08-18T22:20:16.4324418Z +     interval_source = "wald",
2026-08-18T22:20:16.4324625Z +     x = x
2026-08-18T22:20:16.4324702Z +   )
2026-08-18T22:20:16.4324771Z + )
2026-08-18T22:20:16.4324907Z > if (requireNamespace("ggplot2", quietly = TRUE)) {
