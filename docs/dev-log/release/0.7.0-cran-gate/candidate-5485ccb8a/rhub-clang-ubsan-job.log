2026-08-18T22:20:16.4290925Z > ### Name: marginal_parameters
2026-08-18T22:20:16.4291112Z > ### Title: Marginal summaries of predicted distributional parameters
2026-08-18T22:20:16.4291267Z > ### Aliases: marginal_parameters marginal_parameters.drmTMB
2026-08-18T22:20:16.4291437Z > 
2026-08-18T22:20:16.4291515Z > ### ** Examples
2026-08-18T22:20:16.4291584Z > 
2026-08-18T22:20:16.4291659Z > set.seed(20260523)
2026-08-18T22:20:16.4291732Z > n <- 48
2026-08-18T22:20:16.4291822Z > x <- seq(-1.5, 1.5, length.out = n)
2026-08-18T22:20:16.4291969Z > habitat <- factor(rep(c("reef", "sand"), length.out = n))
2026-08-18T22:20:16.4292113Z > eta <- 0.4 + 0.7 * x + ifelse(habitat == "reef", 0.25, -0.15)
2026-08-18T22:20:16.4292198Z > sigma <- exp(-0.35 + 0.15 * x)
2026-08-18T22:20:16.4292384Z > dat <- data.frame(y = eta + rnorm(n, sd = sigma), x = x, habitat = habitat)
2026-08-18T22:20:16.4292513Z > fit <- drmTMB(bf(y ~ x + habitat, sigma ~ x), data = dat)
2026-08-18T22:20:16.4292601Z > grid <- prediction_grid(
2026-08-18T22:20:16.4292670Z +   fit,
2026-08-18T22:20:16.4292752Z +   focal = "habitat",
2026-08-18T22:20:16.4292859Z +   at = list(habitat = levels(dat$habitat)),
2026-08-18T22:20:16.4293194Z +   margin = "empirical"
2026-08-18T22:20:16.4293276Z + )
2026-08-18T22:20:16.4293499Z > marginal_parameters(fit, newdata = grid, dpar = c("mu", "sigma"), by = "habitat")
2026-08-18T22:20:16.4293663Z    dpar            component     type habitat  estimate  n   conf.status
2026-08-18T22:20:16.4293815Z 1    mu             location response    reef 0.8777762 48 not_requested
2026-08-18T22:20:16.4293954Z 2    mu             location response    sand 0.1789187 48 not_requested
2026-08-18T22:20:16.4294139Z 3 sigma distributional-scale response    reef 0.5759517 48 not_requested
2026-08-18T22:20:16.4294314Z 4 sigma distributional-scale response    sand 0.5759517 48 not_requested
2026-08-18T22:20:16.4294396Z   interval_source
2026-08-18T22:20:16.4294473Z 1   not_available
2026-08-18T22:20:16.4294544Z 2   not_available
