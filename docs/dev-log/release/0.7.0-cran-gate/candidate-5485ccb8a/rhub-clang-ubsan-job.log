2026-08-18T22:20:16.4317964Z +     "rho12",
2026-08-18T22:20:16.4318056Z +     "cor((Intercept),x | p | id)",
2026-08-18T22:20:16.4318146Z +     "cor(mu1,mu2 | species)",
2026-08-18T22:20:16.4318237Z +     "cor(sigma1,sigma2 | site)"
2026-08-18T22:20:16.4318306Z +   ),
2026-08-18T22:20:16.4318383Z +   label = c(
2026-08-18T22:20:16.4318464Z +     "Residual\nrho12",
2026-08-18T22:20:16.4318556Z +     "Group\nmean-slope cor",
2026-08-18T22:20:16.4318652Z +     "Phylogenetic\nmu1-mu2",
2026-08-18T22:20:16.4318735Z +     "Group\nsigma block"
2026-08-18T22:20:16.4318807Z +   ),
2026-08-18T22:20:16.4318901Z +   estimate = c(0.25, 0.45, -0.30, 0.12),
2026-08-18T22:20:16.4319010Z +   modelled = c(FALSE, FALSE, FALSE, FALSE),
2026-08-18T22:20:16.4319102Z +   conf.low = c(0.05, 0.10, -0.55, -0.12),
2026-08-18T22:20:16.4319204Z +   conf.high = c(0.43, 0.72, -0.08, 0.34),
2026-08-18T22:20:16.4319304Z +   conf.status = rep("profile", 4),
2026-08-18T22:20:16.4319398Z +   interval_source = rep("profile", 4)
2026-08-18T22:20:16.4319471Z + )
2026-08-18T22:20:16.4319607Z > if (requireNamespace("ggplot2", quietly = TRUE)) {
2026-08-18T22:20:16.4319695Z +   pair_palette <- c(
