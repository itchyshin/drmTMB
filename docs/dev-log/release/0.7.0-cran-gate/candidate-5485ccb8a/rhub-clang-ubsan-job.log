2026-08-18T22:20:16.3959188Z > 
2026-08-18T22:20:16.3959352Z > set.seed(20260723)
2026-08-18T22:20:16.3959567Z > dat <- data.frame(x = rnorm(80))
2026-08-18T22:20:16.3959804Z > z_g <- rnorm(80)
2026-08-18T22:20:16.3960032Z > z_b <- 0.35 * z_g + sqrt(1 - 0.35^2) * rnorm(80)
2026-08-18T22:20:16.3960358Z > dat$trait_continuous <- 0.2 + 0.5 * dat$x + z_g
2026-08-18T22:20:16.3960671Z > dat$trait_binary <- as.integer(z_b > qnorm(0.6))
2026-08-18T22:20:16.3960942Z > 
