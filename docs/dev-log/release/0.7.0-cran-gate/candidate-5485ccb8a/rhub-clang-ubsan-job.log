2026-08-18T22:20:16.4098142Z > ### ** Examples
2026-08-18T22:20:16.4098323Z > 
2026-08-18T22:20:16.4098488Z > set.seed(1)
2026-08-18T22:20:16.4098668Z > n <- 40
2026-08-18T22:20:16.4098840Z > x <- rnorm(n)
2026-08-18T22:20:16.4099028Z > z1 <- rnorm(n)
2026-08-18T22:20:16.4099212Z > z2 <- rnorm(n)
2026-08-18T22:20:16.4099405Z > mu1 <- 0.2 + 0.5 * x
2026-08-18T22:20:16.4099619Z > mu2 <- -0.1 + 0.4 * x
2026-08-18T22:20:16.4099834Z > sigma1 <- exp(-0.2 + 0.15 * z1)
2026-08-18T22:20:16.4100077Z > sigma2 <- exp(0.1 - 0.1 * z2)
2026-08-18T22:20:16.4100305Z > rho <- 0.35
2026-08-18T22:20:16.4100485Z > e1 <- rnorm(n)
2026-08-18T22:20:16.4100700Z > e2 <- rho * e1 + sqrt(1 - rho^2) * rnorm(n)
2026-08-18T22:20:16.4100981Z > dat <- data.frame(
2026-08-18T22:20:16.4101189Z +   y1 = mu1 + sigma1 * e1,
2026-08-18T22:20:16.4101412Z +   y2 = mu2 + sigma2 * e2,
2026-08-18T22:20:16.4101620Z +   x = x,
2026-08-18T22:20:16.4101793Z +   z1 = z1,
2026-08-18T22:20:16.4101966Z +   z2 = z2
2026-08-18T22:20:16.4102258Z + )
2026-08-18T22:20:16.4102423Z > fit <- drmTMB(
2026-08-18T22:20:16.4102610Z +   bf(
2026-08-18T22:20:16.4102778Z +     mu1 = y1 ~ x,
2026-08-18T22:20:16.4103203Z +     mu2 = y2 ~ x,
2026-08-18T22:20:16.4103417Z +     sigma1 = ~ z1,
2026-08-18T22:20:16.4103610Z +     sigma2 = ~ z2,
2026-08-18T22:20:16.4103826Z +     rho12 = ~ 1
2026-08-18T22:20:16.4104034Z +   ),
2026-08-18T22:20:16.4104230Z +   family = c(gaussian(), gaussian()),
2026-08-18T22:20:16.4104492Z +   data = dat
2026-08-18T22:20:16.4104667Z + )
2026-08-18T22:20:16.4104841Z > pairs <- corpairs(fit)
2026-08-18T22:20:16.4105055Z > pairs
2026-08-18T22:20:16.4105328Z      level group block from_dpar  to_dpar from_coef to_coef from_response
