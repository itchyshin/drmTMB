2026-08-18T22:20:16.4344384Z +   condition = list(habitat = "reef")
2026-08-18T22:20:16.4344453Z + )
2026-08-18T22:20:16.4344682Z > predict_parameters(fit, newdata = grid, dpar = c("mu", "sigma"), conf.int = TRUE)
