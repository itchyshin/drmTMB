2026-08-18T22:20:16.4319858Z +     phylo = "#009E73",
2026-08-18T22:20:16.4319944Z +     residual = "#0072B2"
2026-08-18T22:20:16.4320015Z +   )
2026-08-18T22:20:16.4320121Z +   plot_corpairs(pairs, label = "label") +
2026-08-18T22:20:16.4320397Z +     ggplot2::scale_colour_manual(values = pair_palette) +
2026-08-18T22:20:16.4320534Z +     ggplot2::scale_fill_manual(values = pair_palette) +
2026-08-18T22:20:16.4320645Z +     ggplot2::theme_minimal(base_size = 11) +
