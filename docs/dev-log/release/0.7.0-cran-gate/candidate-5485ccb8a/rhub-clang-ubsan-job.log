2026-08-18T22:20:16.4369185Z > 
2026-08-18T22:20:16.4369269Z > set.seed(20260525)
2026-08-18T22:20:16.4369369Z > id <- factor(rep(letters[1:8], each = 8))
2026-08-18T22:20:16.4369480Z > x <- rep(seq(-1, 1, length.out = 8), times = 8)
2026-08-18T22:20:16.4369569Z > u <- rnorm(nlevels(id), sd = 0.9)
2026-08-18T22:20:16.4369652Z > dat <- data.frame(
2026-08-18T22:20:16.4369778Z +   y = 0.2 + 0.7 * x + u[id] + rnorm(length(x), sd = 0.3),
2026-08-18T22:20:16.4369856Z +   x = x,
2026-08-18T22:20:16.4369931Z +   id = id
2026-08-18T22:20:16.4370002Z + )
2026-08-18T22:20:16.4370141Z > fit <- drmTMB(bf(y ~ x + (1 | id), sigma ~ 1), data = dat)
2026-08-18T22:20:16.4370219Z > names(ranef(fit))
2026-08-18T22:20:16.4370295Z [1] "mu"
2026-08-18T22:20:16.4370401Z > head(ranef(fit, "mu")$terms[["(1 | id)"]])
2026-08-18T22:20:16.4370517Z          a          b          c          d          e          f 
2026-08-18T22:20:16.4370663Z  1.3729442  0.6790215 -1.9030966  0.7870208 -1.0692608  0.7551509 
