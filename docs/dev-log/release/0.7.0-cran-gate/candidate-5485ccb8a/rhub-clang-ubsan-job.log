2026-08-18T22:20:16.4215618Z > ### Name: imputed
2026-08-18T22:20:16.4215752Z > ### Title: Extract fitted missing-predictor summaries
2026-08-18T22:20:16.4215857Z > ### Aliases: imputed imputed.drmTMB
2026-08-18T22:20:16.4215934Z > 
2026-08-18T22:20:16.4216008Z > ### ** Examples
2026-08-18T22:20:16.4216082Z > 
2026-08-18T22:20:16.4216160Z > set.seed(20260532)
2026-08-18T22:20:16.4216237Z > n <- 48
2026-08-18T22:20:16.4216320Z > dat <- data.frame(
2026-08-18T22:20:16.4216426Z +   moisture = seq(-1.5, 1.5, length.out = n),
2026-08-18T22:20:16.4216519Z +   canopy = cos(seq_len(n) / 5)
2026-08-18T22:20:16.4216592Z + )
2026-08-18T22:20:16.4216768Z > dat$body_mass_full <- 0.2 + 0.7 * dat$moisture - 0.2 * dat$canopy +
2026-08-18T22:20:16.4216847Z +   rnorm(n, sd = 0.08)
2026-08-18T22:20:16.4217009Z > dat$growth <- 0.6 + 1.1 * dat$body_mass_full - 0.3 * dat$moisture +
2026-08-18T22:20:16.4217093Z +   rnorm(n, sd = 0.20)
