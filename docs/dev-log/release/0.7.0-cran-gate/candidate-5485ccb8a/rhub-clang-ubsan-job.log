2026-08-18T22:20:16.3961369Z +   bf(mu = trait_continuous ~ x, sigma = ~ 1),
2026-08-18T22:20:16.3961670Z +   family = gaussian(), data = dat
2026-08-18T22:20:16.3961915Z + )
2026-08-18T22:20:16.3962086Z > binary_fit <- drmTMB(
