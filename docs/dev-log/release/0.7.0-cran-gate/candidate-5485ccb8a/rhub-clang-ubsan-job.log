2026-08-18T22:20:16.4143769Z > ### Aliases: drm_formula bf
2026-08-18T22:20:16.4143986Z > 
2026-08-18T22:20:16.4144147Z > ### ** Examples
2026-08-18T22:20:16.4144328Z > 
2026-08-18T22:20:16.4144500Z > drm_formula(y ~ x, sigma ~ z)
2026-08-18T22:20:16.4144724Z <drm_formula>
2026-08-18T22:20:16.4144901Z y ~ x
2026-08-18T22:20:16.4145069Z sigma ~ z
2026-08-18T22:20:16.4145307Z > drm_formula(y ~ x + (1 | id), sigma ~ z, sd(id) ~ x_group)
2026-08-18T22:20:16.4145613Z <drm_formula>
2026-08-18T22:20:16.4145802Z y ~ x + (1 | id)
2026-08-18T22:20:16.4145986Z sigma ~ z
2026-08-18T22:20:16.4146160Z sd(id) ~ x_group
2026-08-18T22:20:16.4146346Z > drm_formula(
2026-08-18T22:20:16.4146537Z +   y ~ x + (1 | id) + (1 | site),
2026-08-18T22:20:16.4146773Z +   sigma ~ z,
2026-08-18T22:20:16.4146958Z +   sd(id) ~ x_group,
2026-08-18T22:20:16.4147170Z +   sd(site) ~ site_type
2026-08-18T22:20:16.4147376Z + )
2026-08-18T22:20:16.4147546Z <drm_formula>
2026-08-18T22:20:16.4147779Z y ~ x + (1 | id) + (1 | site)
2026-08-18T22:20:16.4148329Z sigma ~ z
2026-08-18T22:20:16.4148646Z sd(id) ~ x_group
2026-08-18T22:20:16.4148976Z sd(site) ~ site_type
2026-08-18T22:20:16.4149314Z > drm_formula(
2026-08-18T22:20:16.4149641Z +   mu1 = y1 ~ x1 + x2,
2026-08-18T22:20:16.4149994Z +   mu2 = y2 ~ x1,
2026-08-18T22:20:16.4150320Z +   sigma1 = ~ x1,
2026-08-18T22:20:16.4150643Z +   sigma2 = ~ x2,
2026-08-18T22:20:16.4150969Z +   rho12 = ~ x1 + x2
2026-08-18T22:20:16.4151307Z + )
2026-08-18T22:20:16.4151593Z <drm_formula>
2026-08-18T22:20:16.4152176Z mu1 = y1 ~ x1 + x2
2026-08-18T22:20:16.4152497Z mu2 = y2 ~ x1
2026-08-18T22:20:16.4152807Z sigma1 = ~x1
2026-08-18T22:20:16.4153295Z sigma2 = ~x2
2026-08-18T22:20:16.4153486Z rho12 = ~x1 + x2
2026-08-18T22:20:16.4153775Z > drm_formula(mvbind(y1, y2) ~ x1 + x2, sigma1 = ~ x1, sigma2 = ~ x2)
2026-08-18T22:20:16.4154122Z <drm_formula>
2026-08-18T22:20:16.4154310Z mvbind(y1, y2) ~ x1 + x2
2026-08-18T22:20:16.4154531Z sigma1 = ~x1
2026-08-18T22:20:16.4154709Z sigma2 = ~x2
