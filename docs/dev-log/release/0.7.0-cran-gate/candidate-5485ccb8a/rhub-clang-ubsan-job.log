2026-08-18T22:20:16.4342657Z > 
2026-08-18T22:20:16.4342735Z > ### ** Examples
2026-08-18T22:20:16.4342810Z > 
2026-08-18T22:20:16.4342892Z > set.seed(20260523)
2026-08-18T22:20:16.4343094Z > n <- 48
2026-08-18T22:20:16.4343187Z > x <- seq(-1.5, 1.5, length.out = n)
2026-08-18T22:20:16.4343337Z > habitat <- factor(rep(c("reef", "sand"), length.out = n))
2026-08-18T22:20:16.4343470Z > eta <- 0.4 + 0.7 * x + ifelse(habitat == "reef", 0.25, -0.15)
2026-08-18T22:20:16.4343558Z > sigma <- exp(-0.35 + 0.15 * x)
2026-08-18T22:20:16.4343745Z > dat <- data.frame(y = eta + rnorm(n, sd = sigma), x = x, habitat = habitat)
2026-08-18T22:20:16.4343885Z > fit <- drmTMB(bf(y ~ x + habitat, sigma ~ x), data = dat)
2026-08-18T22:20:16.4343958Z > 
2026-08-18T22:20:16.4344046Z > grid <- prediction_grid(
