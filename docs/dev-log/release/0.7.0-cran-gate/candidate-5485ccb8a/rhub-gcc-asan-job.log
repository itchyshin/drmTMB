2026-08-18T22:58:38.1643623Z > base::assign(".ptime", proc.time(), pos = "CheckExEnv")
2026-08-18T22:58:38.1644343Z > ### Name: drm_phylo_penalty_sweep
2026-08-18T22:58:38.1644986Z > ### Title: Prior-sensitivity sweep for the phylogenetic correlation penalty
2026-08-18T22:58:38.1645720Z > ### Aliases: drm_phylo_penalty_sweep
2026-08-18T22:58:38.1646019Z > 
2026-08-18T22:58:38.1646186Z > ### ** Examples
2026-08-18T22:58:38.1646367Z > 
2026-08-18T22:58:38.1646538Z > ## No test: 
2026-08-18T22:58:38.1646761Z > if (requireNamespace("ape", quietly = TRUE)) {
2026-08-18T22:58:38.1647043Z +   set.seed(20260601)
2026-08-18T22:58:38.1647251Z +   n_tip <- 10
2026-08-18T22:58:38.1647452Z +   tree <- ape::rcoal(n_tip)
2026-08-18T22:58:38.1647714Z +   tree$tip.label <- paste0("sp_", seq_len(n_tip))
2026-08-18T22:58:38.1648011Z +   A <- ape::vcv(tree, corr = TRUE)
2026-08-18T22:58:38.1648288Z +   u <- as.vector(t(chol(A)) %*% rnorm(n_tip)) * 0.6
2026-08-18T22:58:38.1648676Z +   species <- factor(rep(tree$tip.label, each = 2), levels = tree$tip.label)
2026-08-18T22:58:38.1649041Z +   x <- rnorm(length(species))
2026-08-18T22:58:38.1649280Z +   dat <- data.frame(
2026-08-18T22:58:38.1649532Z +     y = 0.3 + 0.5 * x + u[rep(seq_len(n_tip), each = 2)] +
2026-08-18T22:58:38.1649834Z +       rnorm(length(species), sd = 0.5),
2026-08-18T22:58:38.1650078Z +     x = x,
2026-08-18T22:58:38.1650262Z +     species = species
2026-08-18T22:58:38.1650464Z +   )
2026-08-18T22:58:38.1650635Z + 
2026-08-18T22:58:38.1651077Z +   # A coupled location-scale phylo model has two phylogenetic SDs, so the
2026-08-18T22:58:38.1651498Z +   # cor_sd sweep is informative (see drm_phylo_penalty()).
2026-08-18T22:58:38.1651812Z +   out <- drm_phylo_penalty_sweep(
2026-08-18T22:58:38.1652323Z +     bf(
2026-08-18T22:58:38.1652531Z +       y ~ x + phylo(1 | species, tree = tree),
2026-08-18T22:58:38.1652831Z +       sigma ~ phylo(1 | species, tree = tree)
2026-08-18T22:58:38.1653099Z +     ),
2026-08-18T22:58:38.1653282Z +     data = dat,
2026-08-18T22:58:38.1653480Z +     family = gaussian(),
2026-08-18T22:58:38.1653702Z +     cor_sd = c(0.5, 1)
2026-08-18T22:58:38.1653909Z +   )
2026-08-18T22:58:38.1654083Z +   out$summary
2026-08-18T22:58:38.1654266Z + }
2026-08-18T22:58:38.1654458Z   cor_sd convergence pdHess    logLik error
2026-08-18T22:58:38.1654733Z 1    0.5           0   TRUE -12.67648  <NA>
2026-08-18T22:58:38.1655004Z 2    1.0           0   TRUE -12.62536  <NA>
2026-08-18T22:58:38.1655330Z > ## End(No test)
2026-08-18T22:58:38.1655516Z > 
2026-08-18T22:58:38.1655679Z > 
