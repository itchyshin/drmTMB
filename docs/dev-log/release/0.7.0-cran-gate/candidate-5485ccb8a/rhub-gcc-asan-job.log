2026-08-18T22:58:38.1539159Z > base::assign(".ptime", proc.time(), pos = "CheckExEnv")
2026-08-18T22:58:38.1539757Z > ### Name: corpairs
2026-08-18T22:58:38.1540207Z > ### Title: Extract fitted correlation pairs
2026-08-18T22:58:38.1540798Z > ### Aliases: corpairs corpairs.drmTMB
2026-08-18T22:58:38.1541311Z > 
2026-08-18T22:58:38.1541638Z > ### ** Examples
2026-08-18T22:58:38.1563204Z > 
2026-08-18T22:58:38.1563521Z > set.seed(1)
2026-08-18T22:58:38.1563920Z > n <- 40
2026-08-18T22:58:38.1564212Z > x <- rnorm(n)
2026-08-18T22:58:38.1564514Z > z1 <- rnorm(n)
2026-08-18T22:58:38.1564698Z > z2 <- rnorm(n)
2026-08-18T22:58:38.1564887Z > mu1 <- 0.2 + 0.5 * x
2026-08-18T22:58:38.1565106Z > mu2 <- -0.1 + 0.4 * x
2026-08-18T22:58:38.1565330Z > sigma1 <- exp(-0.2 + 0.15 * z1)
2026-08-18T22:58:38.1565589Z > sigma2 <- exp(0.1 - 0.1 * z2)
2026-08-18T22:58:38.1565823Z > rho <- 0.35
2026-08-18T22:58:38.1566004Z > e1 <- rnorm(n)
2026-08-18T22:58:38.1566237Z > e2 <- rho * e1 + sqrt(1 - rho^2) * rnorm(n)
2026-08-18T22:58:38.1566524Z > dat <- data.frame(
2026-08-18T22:58:38.1566740Z +   y1 = mu1 + sigma1 * e1,
2026-08-18T22:58:38.1566964Z +   y2 = mu2 + sigma2 * e2,
2026-08-18T22:58:38.1567170Z +   x = x,
2026-08-18T22:58:38.1567343Z +   z1 = z1,
2026-08-18T22:58:38.1567515Z +   z2 = z2
2026-08-18T22:58:38.1567679Z + )
2026-08-18T22:58:38.1567842Z > fit <- drmTMB(
2026-08-18T22:58:38.1568017Z +   bf(
2026-08-18T22:58:38.1568193Z +     mu1 = y1 ~ x,
2026-08-18T22:58:38.1568390Z +     mu2 = y2 ~ x,
2026-08-18T22:58:38.1568577Z +     sigma1 = ~ z1,
2026-08-18T22:58:38.1568773Z +     sigma2 = ~ z2,
2026-08-18T22:58:38.1568959Z +     rho12 = ~ 1
2026-08-18T22:58:38.1569139Z +   ),
2026-08-18T22:58:38.1569330Z +   family = c(gaussian(), gaussian()),
2026-08-18T22:58:38.1569579Z +   data = dat
2026-08-18T22:58:38.1569753Z + )
2026-08-18T22:58:38.1569934Z > pairs <- corpairs(fit)
2026-08-18T22:58:38.1570145Z > pairs
2026-08-18T22:58:38.1570430Z      level group block from_dpar  to_dpar from_coef to_coef from_response
2026-08-18T22:58:38.1570868Z 1 residual  <NA>  <NA>  residual residual      <NA>    <NA>            y1
2026-08-18T22:58:38.1571293Z   to_response    class parameter estimate      min      max n_values
2026-08-18T22:58:38.1571687Z 1          y2 residual     rho12 0.619665 0.619665 0.619665       40
2026-08-18T22:58:38.1572284Z   link_estimate  link_min  link_max modelled   conf.status interval_source
2026-08-18T22:58:38.1572741Z 1     0.7244622 0.7244622 0.7244622    FALSE not_requested   not_available
2026-08-18T22:58:38.1573100Z > corpairs(fit, level = "residual")
2026-08-18T22:58:38.1573451Z      level group block from_dpar  to_dpar from_coef to_coef from_response
2026-08-18T22:58:38.1573876Z 1 residual  <NA>  <NA>  residual residual      <NA>    <NA>            y1
2026-08-18T22:58:38.1574297Z   to_response    class parameter estimate      min      max n_values
2026-08-18T22:58:38.1574677Z 1          y2 residual     rho12 0.619665 0.619665 0.619665       40
2026-08-18T22:58:38.1575078Z   link_estimate  link_min  link_max modelled   conf.status interval_source
2026-08-18T22:58:38.1575511Z 1     0.7244622 0.7244622 0.7244622    FALSE not_requested   not_available
2026-08-18T22:58:38.1575827Z > 
2026-08-18T22:58:38.1576091Z > # Profile intervals are opt-in and can be slow for large models.
2026-08-18T22:58:38.1576460Z > # corpairs(fit, level = "residual", conf.int = TRUE)
2026-08-18T22:58:38.1576742Z > 
2026-08-18T22:58:38.1576912Z > 
2026-08-18T22:58:38.1577306Z > 
2026-08-18T22:58:38.1577661Z > base::assign(".dptime", (proc.time() - get(".ptime", pos = "CheckExEnv")), pos = "CheckExEnv")
2026-08-18T22:58:38.1578472Z > base::cat("corpairs", base::get(".format_ptime", pos = 'CheckExEnv')(get(".dptime", pos = "CheckExEnv")), "\n", file=base::get(".ExTimings", pos = 'CheckExEnv'), append=TRUE, sep="\t")
