2026-08-18T22:58:38.1793993Z > ### Name: marginal_parameters
2026-08-18T22:58:38.1794167Z > ### Title: Marginal summaries of predicted distributional parameters
2026-08-18T22:58:38.1794323Z > ### Aliases: marginal_parameters marginal_parameters.drmTMB
2026-08-18T22:58:38.1794395Z > 
2026-08-18T22:58:38.1794477Z > ### ** Examples
2026-08-18T22:58:38.1794550Z > 
2026-08-18T22:58:38.1794643Z > set.seed(20260523)
2026-08-18T22:58:38.1794723Z > n <- 48
2026-08-18T22:58:38.1794816Z > x <- seq(-1.5, 1.5, length.out = n)
2026-08-18T22:58:38.1794965Z > habitat <- factor(rep(c("reef", "sand"), length.out = n))
2026-08-18T22:58:38.1795102Z > eta <- 0.4 + 0.7 * x + ifelse(habitat == "reef", 0.25, -0.15)
2026-08-18T22:58:38.1795197Z > sigma <- exp(-0.35 + 0.15 * x)
2026-08-18T22:58:38.1795384Z > dat <- data.frame(y = eta + rnorm(n, sd = sigma), x = x, habitat = habitat)
2026-08-18T22:58:38.1795858Z > fit <- drmTMB(bf(y ~ x + habitat, sigma ~ x), data = dat)
2026-08-18T22:58:38.1795952Z > grid <- prediction_grid(
2026-08-18T22:58:38.1796023Z +   fit,
2026-08-18T22:58:38.1796112Z +   focal = "habitat",
2026-08-18T22:58:38.1796230Z +   at = list(habitat = levels(dat$habitat)),
2026-08-18T22:58:38.1796316Z +   margin = "empirical"
2026-08-18T22:58:38.1796401Z + )
2026-08-18T22:58:38.1796616Z > marginal_parameters(fit, newdata = grid, dpar = c("mu", "sigma"), by = "habitat")
2026-08-18T22:58:38.1796888Z    dpar            component     type habitat  estimate  n   conf.status
2026-08-18T22:58:38.1797036Z 1    mu             location response    reef 0.8777762 48 not_requested
2026-08-18T22:58:38.1797183Z 2    mu             location response    sand 0.1789187 48 not_requested
2026-08-18T22:58:38.1797370Z 3 sigma distributional-scale response    reef 0.5759517 48 not_requested
2026-08-18T22:58:38.1797543Z 4 sigma distributional-scale response    sand 0.5759517 48 not_requested
2026-08-18T22:58:38.1797630Z   interval_source
2026-08-18T22:58:38.1797712Z 1   not_available
2026-08-18T22:58:38.1797799Z 2   not_available
2026-08-18T22:58:38.1797888Z 3   not_available
2026-08-18T22:58:38.1797965Z 4   not_available
