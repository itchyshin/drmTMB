2026-08-18T22:58:38.1891488Z > ### Name: random_effect_scale_formulas
2026-08-18T22:58:38.1891606Z > ### Title: Random-effect scale formula syntax
2026-08-18T22:58:38.1891778Z > ### Aliases: random_effect_scale_formulas sd sd1 sd2 sd_phylo sd_phylo1
2026-08-18T22:58:38.1891859Z > ###   sd_phylo2
2026-08-18T22:58:38.1892039Z > 
2026-08-18T22:58:38.1892123Z > ### ** Examples
2026-08-18T22:58:38.1892264Z > 
2026-08-18T22:58:38.1892375Z > bf(y ~ x + (1 | id), sigma ~ z, sd(id) ~ habitat)
2026-08-18T22:58:38.1892462Z <drm_formula>
2026-08-18T22:58:38.1892536Z y ~ x + (1 | id)
2026-08-18T22:58:38.1892615Z sigma ~ z
2026-08-18T22:58:38.1892688Z sd(id) ~ habitat
2026-08-18T22:58:38.1892765Z > 
2026-08-18T22:58:38.1892845Z > bf(
2026-08-18T22:58:38.1892930Z +   mu1 = y1 ~ x + (1 | p | id),
2026-08-18T22:58:38.1893021Z +   mu2 = y2 ~ x + (1 | p | id),
2026-08-18T22:58:38.1893101Z +   sd1(id) ~ habitat,
2026-08-18T22:58:38.1893183Z +   sd2(id) ~ habitat,
2026-08-18T22:58:38.1893258Z +   rho12 = ~ x
2026-08-18T22:58:38.1893336Z + )
2026-08-18T22:58:38.1893421Z <drm_formula>
2026-08-18T22:58:38.1893503Z mu1 = y1 ~ x + (1 | p | id)
2026-08-18T22:58:38.1893594Z mu2 = y2 ~ x + (1 | p | id)
2026-08-18T22:58:38.1893667Z sd1(id) ~ habitat
2026-08-18T22:58:38.1893749Z sd2(id) ~ habitat
2026-08-18T22:58:38.1893822Z rho12 = ~x
2026-08-18T22:58:38.1893898Z > 
2026-08-18T22:58:38.1893978Z > bf(
2026-08-18T22:58:38.1894083Z +   y ~ x + phylo(1 | species, tree = tree),
2026-08-18T22:58:38.1894203Z +   sd(species, level = "phylogenetic") ~ ecology
2026-08-18T22:58:38.1894273Z + )
2026-08-18T22:58:38.1894355Z <drm_formula>
2026-08-18T22:58:38.1894457Z y ~ x + phylo(1 | species, tree = tree)
2026-08-18T22:58:38.1894563Z sd(species, level = "phylogenetic") ~ ecology
2026-08-18T22:58:38.1894642Z > 
2026-08-18T22:58:38.1894712Z > 
2026-08-18T22:58:38.1894788Z > 
2026-08-18T22:58:38.1894857Z > 
