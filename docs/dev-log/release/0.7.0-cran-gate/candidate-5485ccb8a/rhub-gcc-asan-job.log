2026-08-18T22:58:38.1725722Z > ### Name: imputed
2026-08-18T22:58:38.1725856Z > ### Title: Extract fitted missing-predictor summaries
2026-08-18T22:58:38.1725963Z > ### Aliases: imputed imputed.drmTMB
2026-08-18T22:58:38.1726043Z > 
2026-08-18T22:58:38.1726206Z > ### ** Examples
2026-08-18T22:58:38.1726277Z > 
2026-08-18T22:58:38.1726367Z > set.seed(20260532)
2026-08-18T22:58:38.1726452Z > n <- 48
2026-08-18T22:58:38.1726531Z > dat <- data.frame(
2026-08-18T22:58:38.1726644Z +   moisture = seq(-1.5, 1.5, length.out = n),
2026-08-18T22:58:38.1726734Z +   canopy = cos(seq_len(n) / 5)
2026-08-18T22:58:38.1726815Z + )
2026-08-18T22:58:38.1726994Z > dat$body_mass_full <- 0.2 + 0.7 * dat$moisture - 0.2 * dat$canopy +
2026-08-18T22:58:38.1727075Z +   rnorm(n, sd = 0.08)
2026-08-18T22:58:38.1727233Z > dat$growth <- 0.6 + 1.1 * dat$body_mass_full - 0.3 * dat$moisture +
2026-08-18T22:58:38.1727311Z +   rnorm(n, sd = 0.20)
2026-08-18T22:58:38.1727413Z > dat$body_mass <- dat$body_mass_full
2026-08-18T22:58:38.1727516Z > dat$body_mass[c(7, 19, 34, 43)] <- NA_real_
2026-08-18T22:58:38.1727593Z > 
2026-08-18T22:58:38.1727679Z > fit <- drmTMB(
2026-08-18T22:58:38.1727801Z +   bf(growth ~ moisture + mi(body_mass), sigma ~ 1),
2026-08-18T22:58:38.1728008Z +   family = gaussian(),
2026-08-18T22:58:38.1728087Z +   data = dat,
2026-08-18T22:58:38.1728237Z +   impute = list(body_mass = body_mass ~ moisture + canopy),
2026-08-18T22:58:38.1728355Z +   missing = miss_control(predictor = "model")
2026-08-18T22:58:38.1728429Z + )
2026-08-18T22:58:38.1728515Z > imputed(fit)
2026-08-18T22:58:38.1728679Z    variable original_row model_row observed   estimate  std_error
2026-08-18T22:58:38.1728824Z 1 body_mass            7         7    FALSE -0.5977839 0.06694745
2026-08-18T22:58:38.1728952Z 2 body_mass           19        19    FALSE  0.1230898 0.06692573
2026-08-18T22:58:38.1729090Z 3 body_mass           34        34    FALSE  0.4920569 0.06762264
2026-08-18T22:58:38.1729219Z 4 body_mass           43        43    FALSE  1.1676530 0.06729264
2026-08-18T22:58:38.1729315Z             source uncertainty_status
2026-08-18T22:58:38.1729413Z 1 conditional_mode                 ok
2026-08-18T22:58:38.1729501Z 2 conditional_mode                 ok
2026-08-18T22:58:38.1729606Z 3 conditional_mode                 ok
2026-08-18T22:58:38.1729705Z 4 conditional_mode                 ok
2026-08-18T22:58:38.1729773Z > 
