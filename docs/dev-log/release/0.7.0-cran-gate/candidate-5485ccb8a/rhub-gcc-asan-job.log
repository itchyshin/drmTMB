2026-08-18T22:58:38.1906683Z > ### Name: rho12
2026-08-18T22:58:38.1906798Z > ### Title: Extract residual correlation rho12
2026-08-18T22:58:38.1906885Z > ### Aliases: rho12 rho12.drmTMB
2026-08-18T22:58:38.1906963Z > 
2026-08-18T22:58:38.1907089Z > ### ** Examples
2026-08-18T22:58:38.1907170Z > 
2026-08-18T22:58:38.1907253Z > set.seed(20260525)
2026-08-18T22:58:38.1907328Z > n <- 36
2026-08-18T22:58:38.1907424Z > x <- seq(-1, 1, length.out = n)
2026-08-18T22:58:38.1907498Z > e1 <- rnorm(n)
2026-08-18T22:58:38.1907605Z > e2 <- 0.4 * e1 + sqrt(1 - 0.4^2) * rnorm(n)
