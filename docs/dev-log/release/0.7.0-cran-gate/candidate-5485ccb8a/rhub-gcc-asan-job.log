2026-08-18T22:58:38.1694420Z (Intercept)           x 
2026-08-18T22:58:38.1694548Z -0.63277067 -0.01385506 
2026-08-18T22:58:38.1694563Z 
2026-08-18T22:58:38.1694884Z > names(coef(fit))
2026-08-18T22:58:38.1695027Z [1] "mu"    "sigma"
2026-08-18T22:58:38.1695193Z > identical(coef(fit), fixef(fit))
2026-08-18T22:58:38.1695338Z [1] TRUE
