2026-08-18T22:58:38.1618985Z > ### Name: drm_formula
2026-08-18T22:58:38.1619505Z > ### Title: Build a drmTMB formula object
2026-08-18T22:58:38.1620010Z > ### Aliases: drm_formula bf
2026-08-18T22:58:38.1620489Z > 
2026-08-18T22:58:38.1620752Z > ### ** Examples
2026-08-18T22:58:38.1621038Z > 
2026-08-18T22:58:38.1621241Z > drm_formula(y ~ x, sigma ~ z)
2026-08-18T22:58:38.1621548Z <drm_formula>
2026-08-18T22:58:38.1621811Z y ~ x
2026-08-18T22:58:38.1622172Z sigma ~ z
2026-08-18T22:58:38.1622534Z > drm_formula(y ~ x + (1 | id), sigma ~ z, sd(id) ~ x_group)
2026-08-18T22:58:38.1622991Z <drm_formula>
2026-08-18T22:58:38.1623174Z y ~ x + (1 | id)
2026-08-18T22:58:38.1623366Z sigma ~ z
2026-08-18T22:58:38.1623537Z sd(id) ~ x_group
2026-08-18T22:58:38.1623720Z > drm_formula(
2026-08-18T22:58:38.1623907Z +   y ~ x + (1 | id) + (1 | site),
2026-08-18T22:58:38.1624159Z +   sigma ~ z,
2026-08-18T22:58:38.1624472Z +   sd(id) ~ x_group,
2026-08-18T22:58:38.1624681Z +   sd(site) ~ site_type
2026-08-18T22:58:38.1624881Z + )
2026-08-18T22:58:38.1625058Z <drm_formula>
2026-08-18T22:58:38.1625256Z y ~ x + (1 | id) + (1 | site)
2026-08-18T22:58:38.1625466Z sigma ~ z
2026-08-18T22:58:38.1625639Z sd(id) ~ x_group
2026-08-18T22:58:38.1625887Z sd(site) ~ site_type
2026-08-18T22:58:38.1626153Z > drm_formula(
2026-08-18T22:58:38.1626339Z +   mu1 = y1 ~ x1 + x2,
2026-08-18T22:58:38.1626538Z +   mu2 = y2 ~ x1,
2026-08-18T22:58:38.1626734Z +   sigma1 = ~ x1,
2026-08-18T22:58:38.1626924Z +   sigma2 = ~ x2,
2026-08-18T22:58:38.1627115Z +   rho12 = ~ x1 + x2
2026-08-18T22:58:38.1627302Z + )
2026-08-18T22:58:38.1627516Z <drm_formula>
2026-08-18T22:58:38.1627846Z mu1 = y1 ~ x1 + x2
2026-08-18T22:58:38.1628027Z mu2 = y2 ~ x1
2026-08-18T22:58:38.1628217Z sigma1 = ~x1
2026-08-18T22:58:38.1628394Z sigma2 = ~x2
2026-08-18T22:58:38.1628578Z rho12 = ~x1 + x2
2026-08-18T22:58:38.1628859Z > drm_formula(mvbind(y1, y2) ~ x1 + x2, sigma1 = ~ x1, sigma2 = ~ x2)
2026-08-18T22:58:38.1629277Z <drm_formula>
2026-08-18T22:58:38.1629580Z mvbind(y1, y2) ~ x1 + x2
2026-08-18T22:58:38.1629913Z sigma1 = ~x1
2026-08-18T22:58:38.1630166Z sigma2 = ~x2
2026-08-18T22:58:38.1630661Z > 
2026-08-18T22:58:38.1630924Z > 
2026-08-18T22:58:38.1631182Z > 
2026-08-18T22:58:38.1631702Z > base::assign(".dptime", (proc.time() - get(".ptime", pos = "CheckExEnv")), pos = "CheckExEnv")
2026-08-18T22:58:38.1632811Z > base::cat("drm_formula", base::get(".format_ptime", pos = 'CheckExEnv')(get(".dptime", pos = "CheckExEnv")), "\n", file=base::get(".ExTimings", pos = 'CheckExEnv'), append=TRUE, sep="\t")
