2026-08-18T22:22:52.8079264Z > ### Name: fixef
2026-08-18T22:22:52.8079442Z > ### Title: Extract fixed-effect coefficients
2026-08-18T22:22:52.8079945Z > ### Aliases: fixef fixef.drmTMB coef.drmTMB
2026-08-18T22:22:52.8080065Z > 
2026-08-18T22:22:52.8080192Z > ### ** Examples
2026-08-18T22:22:52.8080304Z > 
2026-08-18T22:22:52.8080438Z > set.seed(20260525)
2026-08-18T22:22:52.8080562Z > dat <- data.frame(
2026-08-18T22:22:52.8080795Z +   y = 0.2 + 0.6 * seq(-1, 1, length.out = 24) + rnorm(24, sd = 0.5),
2026-08-18T22:22:52.8080934Z +   x = seq(-1, 1, length.out = 24)
2026-08-18T22:22:52.8081048Z + )
2026-08-18T22:22:52.8081221Z > fit <- drmTMB(bf(y ~ x, sigma ~ x), data = dat)
2026-08-18T22:22:52.8081329Z > 
2026-08-18T22:22:52.8081594Z > # One distributional parameter at a time: a named numeric vector.
2026-08-18T22:22:52.8081718Z > fixef(fit, "mu")
2026-08-18T22:22:52.8081854Z (Intercept)           x 
2026-08-18T22:22:52.8082218Z   0.2280971   0.5919767 
2026-08-18T22:22:52.8082337Z > coef(fit, "sigma")
2026-08-18T22:22:52.8082474Z (Intercept)           x 
2026-08-18T22:22:52.8082597Z -0.63277067 -0.01385506 
2026-08-18T22:22:52.8082717Z > 
2026-08-18T22:22:52.8083001Z > # Omit `dpar` for every block at once: a named list, one element per
2026-08-18T22:22:52.8083334Z > # distributional parameter. `coef()` and `fixef()` return the same structure.
2026-08-18T22:22:52.8083454Z > coef(fit)
2026-08-18T22:22:52.8083561Z $mu
2026-08-18T22:22:52.8083699Z (Intercept)           x 
2026-08-18T22:22:52.8083800Z   0.2280971   0.5919767 
2026-08-18T22:22:52.8083806Z 
2026-08-18T22:22:52.8083916Z $sigma
2026-08-18T22:22:52.8084044Z (Intercept)           x 
2026-08-18T22:22:52.8084156Z -0.63277067 -0.01385506 
2026-08-18T22:22:52.8084163Z 
2026-08-18T22:22:52.8084287Z > names(coef(fit))
2026-08-18T22:22:52.8084399Z [1] "mu"    "sigma"
2026-08-18T22:22:52.8084548Z > identical(coef(fit), fixef(fit))
2026-08-18T22:22:52.8084658Z [1] TRUE
2026-08-18T22:22:52.8084770Z > 
2026-08-18T22:22:52.8084884Z > 
