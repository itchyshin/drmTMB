2026-08-18T22:22:52.8018595Z > ### Name: corpairs
2026-08-18T22:22:52.8018821Z > ### Title: Extract fitted correlation pairs
2026-08-18T22:22:52.8019103Z > ### Aliases: corpairs corpairs.drmTMB
2026-08-18T22:22:52.8019351Z > 
2026-08-18T22:22:52.8019520Z > ### ** Examples
2026-08-18T22:22:52.8019707Z > 
2026-08-18T22:22:52.8019876Z > set.seed(1)
2026-08-18T22:22:52.8020064Z > n <- 40
2026-08-18T22:22:52.8020255Z > x <- rnorm(n)
2026-08-18T22:22:52.8020464Z > z1 <- rnorm(n)
2026-08-18T22:22:52.8020650Z > z2 <- rnorm(n)
2026-08-18T22:22:52.8020839Z > mu1 <- 0.2 + 0.5 * x
2026-08-18T22:22:52.8021053Z > mu2 <- -0.1 + 0.4 * x
2026-08-18T22:22:52.8021289Z > sigma1 <- exp(-0.2 + 0.15 * z1)
2026-08-18T22:22:52.8021544Z > sigma2 <- exp(0.1 - 0.1 * z2)
2026-08-18T22:22:52.8021773Z > rho <- 0.35
2026-08-18T22:22:52.8021993Z > e1 <- rnorm(n)
2026-08-18T22:22:52.8022217Z > e2 <- rho * e1 + sqrt(1 - rho^2) * rnorm(n)
2026-08-18T22:22:52.8022496Z > dat <- data.frame(
2026-08-18T22:22:52.8022710Z +   y1 = mu1 + sigma1 * e1,
2026-08-18T22:22:52.8022935Z +   y2 = mu2 + sigma2 * e2,
2026-08-18T22:22:52.8023149Z +   x = x,
2026-08-18T22:22:52.8023327Z +   z1 = z1,
2026-08-18T22:22:52.8023511Z +   z2 = z2
2026-08-18T22:22:52.8023687Z + )
2026-08-18T22:22:52.8023862Z > fit <- drmTMB(
2026-08-18T22:22:52.8024049Z +   bf(
2026-08-18T22:22:52.8024225Z +     mu1 = y1 ~ x,
2026-08-18T22:22:52.8024419Z +     mu2 = y2 ~ x,
2026-08-18T22:22:52.8024614Z +     sigma1 = ~ z1,
2026-08-18T22:22:52.8024821Z +     sigma2 = ~ z2,
2026-08-18T22:22:52.8025013Z +     rho12 = ~ 1
2026-08-18T22:22:52.8025204Z +   ),
2026-08-18T22:22:52.8025402Z +   family = c(gaussian(), gaussian()),
2026-08-18T22:22:52.8025654Z +   data = dat
2026-08-18T22:22:52.8025851Z + )
2026-08-18T22:22:52.8026041Z > pairs <- corpairs(fit)
2026-08-18T22:22:52.8026257Z > pairs
2026-08-18T22:22:52.8026535Z      level group block from_dpar  to_dpar from_coef to_coef from_response
2026-08-18T22:22:52.8027112Z 1 residual  <NA>  <NA>  residual residual      <NA>    <NA>            y1
2026-08-18T22:22:52.8027552Z   to_response    class parameter estimate      min      max n_values
2026-08-18T22:22:52.8027929Z 1          y2 residual     rho12 0.619665 0.619665 0.619665       40
2026-08-18T22:22:52.8028327Z   link_estimate  link_min  link_max modelled   conf.status interval_source
2026-08-18T22:22:52.8028765Z 1     0.7244622 0.7244622 0.7244622    FALSE not_requested   not_available
2026-08-18T22:22:52.8029106Z > corpairs(fit, level = "residual")
2026-08-18T22:22:52.8029455Z      level group block from_dpar  to_dpar from_coef to_coef from_response
2026-08-18T22:22:52.8029861Z 1 residual  <NA>  <NA>  residual residual      <NA>    <NA>            y1
2026-08-18T22:22:52.8030259Z   to_response    class parameter estimate      min      max n_values
2026-08-18T22:22:52.8030617Z 1          y2 residual     rho12 0.619665 0.619665 0.619665       40
2026-08-18T22:22:52.8031002Z   link_estimate  link_min  link_max modelled   conf.status interval_source
2026-08-18T22:22:52.8031407Z 1     0.7244622 0.7244622 0.7244622    FALSE not_requested   not_available
2026-08-18T22:22:52.8031719Z > 
2026-08-18T22:22:52.8031980Z > # Profile intervals are opt-in and can be slow for large models.
