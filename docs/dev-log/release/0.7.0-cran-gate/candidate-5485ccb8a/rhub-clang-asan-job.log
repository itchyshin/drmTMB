2026-08-18T22:22:52.8049265Z > ### Name: drm_formula
2026-08-18T22:22:52.8049420Z > ### Title: Build a drmTMB formula object
2026-08-18T22:22:52.8049545Z > ### Aliases: drm_formula bf
2026-08-18T22:22:52.8049646Z > 
2026-08-18T22:22:52.8049748Z > ### ** Examples
2026-08-18T22:22:52.8049862Z > 
2026-08-18T22:22:52.8049982Z > drm_formula(y ~ x, sigma ~ z)
2026-08-18T22:22:52.8050097Z <drm_formula>
2026-08-18T22:22:52.8050209Z y ~ x
2026-08-18T22:22:52.8050335Z sigma ~ z
2026-08-18T22:22:52.8050566Z > drm_formula(y ~ x + (1 | id), sigma ~ z, sd(id) ~ x_group)
2026-08-18T22:22:52.8050685Z <drm_formula>
2026-08-18T22:22:52.8050788Z y ~ x + (1 | id)
2026-08-18T22:22:52.8050865Z sigma ~ z
2026-08-18T22:22:52.8050948Z sd(id) ~ x_group
2026-08-18T22:22:52.8051024Z > drm_formula(
2026-08-18T22:22:52.8051113Z +   y ~ x + (1 | id) + (1 | site),
2026-08-18T22:22:52.8051195Z +   sigma ~ z,
2026-08-18T22:22:52.8051295Z +   sd(id) ~ x_group,
2026-08-18T22:22:52.8051442Z +   sd(site) ~ site_type
2026-08-18T22:22:52.8051554Z + )
2026-08-18T22:22:52.8051637Z <drm_formula>
2026-08-18T22:22:52.8051725Z y ~ x + (1 | id) + (1 | site)
2026-08-18T22:22:52.8051802Z sigma ~ z
2026-08-18T22:22:52.8051952Z sd(id) ~ x_group
2026-08-18T22:22:52.8052056Z sd(site) ~ site_type
2026-08-18T22:22:52.8052139Z > drm_formula(
2026-08-18T22:22:52.8052278Z +   mu1 = y1 ~ x1 + x2,
2026-08-18T22:22:52.8052411Z +   mu2 = y2 ~ x1,
2026-08-18T22:22:52.8052499Z +   sigma1 = ~ x1,
2026-08-18T22:22:52.8052576Z +   sigma2 = ~ x2,
2026-08-18T22:22:52.8052660Z +   rho12 = ~ x1 + x2
2026-08-18T22:22:52.8052733Z + )
2026-08-18T22:22:52.8052815Z <drm_formula>
2026-08-18T22:22:52.8052891Z mu1 = y1 ~ x1 + x2
2026-08-18T22:22:52.8052973Z mu2 = y2 ~ x1
2026-08-18T22:22:52.8053118Z sigma1 = ~x1
2026-08-18T22:22:52.8053245Z sigma2 = ~x2
2026-08-18T22:22:52.8053369Z rho12 = ~x1 + x2
2026-08-18T22:22:52.8053601Z > drm_formula(mvbind(y1, y2) ~ x1 + x2, sigma1 = ~ x1, sigma2 = ~ x2)
2026-08-18T22:22:52.8053691Z <drm_formula>
2026-08-18T22:22:52.8053775Z mvbind(y1, y2) ~ x1 + x2
2026-08-18T22:22:52.8053894Z sigma1 = ~x1
2026-08-18T22:22:52.8054026Z sigma2 = ~x2
2026-08-18T22:22:52.8054120Z > 
2026-08-18T22:22:52.8054204Z > 
