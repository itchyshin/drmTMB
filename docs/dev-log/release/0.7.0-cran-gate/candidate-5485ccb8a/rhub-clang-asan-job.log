2026-08-18T22:22:52.8262210Z +   x = x,
2026-08-18T22:22:52.8262285Z +   id = id
2026-08-18T22:22:52.8262363Z + )
2026-08-18T22:22:52.8262496Z > fit <- drmTMB(bf(y ~ x + (1 | id), sigma ~ 1), data = dat)
2026-08-18T22:22:52.8262581Z > names(ranef(fit))
2026-08-18T22:22:52.8262660Z [1] "mu"
2026-08-18T22:22:52.8262761Z > head(ranef(fit, "mu")$terms[["(1 | id)"]])
