2026-08-18T21:55:58.9703990Z         if (length(family) == 4L) {
2026-08-18T21:55:58.9704258Z             family <- c(family, "Symbol.afm")
2026-08-18T21:55:58.9704525Z         }
2026-08-18T21:55:58.9704723Z         else if (length(family) == 5L) {
2026-08-18T21:55:58.9704970Z         }
2026-08-18T21:55:58.9705156Z         else if (length(family) == 1L) {
2026-08-18T21:55:58.9705422Z             pf <- pdfFonts(family)[[1L]]
2026-08-18T21:55:58.9705680Z             if (is.null(pf)) 
2026-08-18T21:55:58.9705960Z                 stop(gettextf("unknown family '%s'", family), 
2026-08-18T21:55:58.9706265Z                   domain = NA)
2026-08-18T21:55:58.9706501Z             matchFont(pf, old$encoding)
2026-08-18T21:55:58.9706747Z         }
2026-08-18T21:55:58.9706954Z         else stop("invalid 'family' argument")
2026-08-18T21:55:58.9707696Z         old$family <- family
2026-08-18T21:55:58.9708041Z     }
