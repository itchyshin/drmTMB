2026-08-18T22:22:52.8265090Z sigma ~ temperature
2026-08-18T22:22:52.8265166Z > 
2026-08-18T22:22:52.8265358Z > # Fitted: a user-built sparse precision for another dependence structure.
2026-08-18T22:22:52.8265593Z > bf(growth ~ treatment + relmat(1 | plot, Q = Q_plot),
2026-08-18T22:22:52.8265768Z +   sigma ~ treatment
2026-08-18T22:22:52.8265842Z + )
2026-08-18T22:22:52.8265922Z <drm_formula>
