2026-08-18T22:22:52.8234766Z > 
2026-08-18T22:22:52.8234852Z > set.seed(20260523)
2026-08-18T22:22:52.8234932Z > n <- 48
2026-08-18T22:22:52.8235031Z > x <- seq(-1.5, 1.5, length.out = n)
