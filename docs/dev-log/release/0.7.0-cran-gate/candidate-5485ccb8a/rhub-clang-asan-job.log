2026-08-18T22:22:52.8055177Z > ### Name: drm_phylo_penalty
2026-08-18T22:22:52.8055476Z > ### Title: Penalty / prior specification for a phylogenetic location-scale
2026-08-18T22:22:52.8055561Z > ###   fit
2026-08-18T22:22:52.8055656Z > ### Aliases: drm_phylo_penalty
2026-08-18T22:22:52.8055734Z > 
2026-08-18T22:22:52.8055821Z > ### ** Examples
2026-08-18T22:22:52.8055902Z > 
2026-08-18T22:22:52.8056110Z > # Penalised-complexity prior: a priori P(phylogenetic SD > 1) = 0.05.
2026-08-18T22:22:52.8056250Z > pen <- drm_phylo_penalty(sd_u = 1, sd_alpha = 0.05)
2026-08-18T22:22:52.8056335Z > pen$rate
2026-08-18T22:22:52.8056410Z [1] 2.995732
2026-08-18T22:22:52.8056488Z > 
2026-08-18T22:22:52.8056686Z > # Also penalize the phylogenetic correlation in a coupled location-scale or
2026-08-18T22:22:52.8056790Z > # bivariate phylogenetic model.
2026-08-18T22:22:52.8056956Z > pen_cor <- drm_phylo_penalty(sd_u = 1, sd_alpha = 0.05, cor_sd = 0.5)
2026-08-18T22:22:52.8057230Z > pen_cor$cor_sd
2026-08-18T22:22:52.8057336Z [1] 0.5
2026-08-18T22:22:52.8057454Z > 
2026-08-18T22:22:52.8057562Z > 
2026-08-18T22:22:52.8057665Z > 
