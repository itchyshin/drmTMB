2026-08-18T22:22:52.8257355Z > ###   sd_phylo2
2026-08-18T22:22:52.8257432Z > 
2026-08-18T22:22:52.8257512Z > ### ** Examples
2026-08-18T22:22:52.8257586Z > 
2026-08-18T22:22:52.8257701Z > bf(y ~ x + (1 | id), sigma ~ z, sd(id) ~ habitat)
2026-08-18T22:22:52.8257785Z <drm_formula>
2026-08-18T22:22:52.8257866Z y ~ x + (1 | id)
2026-08-18T22:22:52.8257942Z sigma ~ z
2026-08-18T22:22:52.8258296Z sd(id) ~ habitat
2026-08-18T22:22:52.8258371Z > 
2026-08-18T22:22:52.8258449Z > bf(
2026-08-18T22:22:52.8258539Z +   mu1 = y1 ~ x + (1 | p | id),
2026-08-18T22:22:52.8258626Z +   mu2 = y2 ~ x + (1 | p | id),
2026-08-18T22:22:52.8258712Z +   sd1(id) ~ habitat,
2026-08-18T22:22:52.8258792Z +   sd2(id) ~ habitat,
2026-08-18T22:22:52.8258875Z +   rho12 = ~ x
2026-08-18T22:22:52.8258947Z + )
2026-08-18T22:22:52.8259029Z <drm_formula>
2026-08-18T22:22:52.8259114Z mu1 = y1 ~ x + (1 | p | id)
2026-08-18T22:22:52.8259197Z mu2 = y2 ~ x + (1 | p | id)
2026-08-18T22:22:52.8259279Z sd1(id) ~ habitat
2026-08-18T22:22:52.8259356Z sd2(id) ~ habitat
2026-08-18T22:22:52.8259437Z rho12 = ~x
2026-08-18T22:22:52.8259511Z > 
2026-08-18T22:22:52.8259587Z > bf(
2026-08-18T22:22:52.8259699Z +   y ~ x + phylo(1 | species, tree = tree),
2026-08-18T22:22:52.8259814Z +   sd(species, level = "phylogenetic") ~ ecology
2026-08-18T22:22:52.8259889Z + )
2026-08-18T22:22:52.8259968Z <drm_formula>
2026-08-18T22:22:52.8260079Z y ~ x + phylo(1 | species, tree = tree)
2026-08-18T22:22:52.8260192Z sd(species, level = "phylogenetic") ~ ecology
