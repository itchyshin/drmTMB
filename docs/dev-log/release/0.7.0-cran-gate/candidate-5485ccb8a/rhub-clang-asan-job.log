2026-08-18T22:22:52.8176429Z > ### Name: marginal_parameters
2026-08-18T22:22:52.8176614Z > ### Title: Marginal summaries of predicted distributional parameters
2026-08-18T22:22:52.8176772Z > ### Aliases: marginal_parameters marginal_parameters.drmTMB
2026-08-18T22:22:52.8176845Z > 
2026-08-18T22:22:52.8176930Z > ### ** Examples
2026-08-18T22:22:52.8177192Z > 
2026-08-18T22:22:52.8177288Z > set.seed(20260523)
2026-08-18T22:22:52.8177366Z > n <- 48
2026-08-18T22:22:52.8177471Z > x <- seq(-1.5, 1.5, length.out = n)
2026-08-18T22:22:52.8177626Z > habitat <- factor(rep(c("reef", "sand"), length.out = n))
2026-08-18T22:22:52.8177765Z > eta <- 0.4 + 0.7 * x + ifelse(habitat == "reef", 0.25, -0.15)
2026-08-18T22:22:52.8177860Z > sigma <- exp(-0.35 + 0.15 * x)
2026-08-18T22:22:52.8178042Z > dat <- data.frame(y = eta + rnorm(n, sd = sigma), x = x, habitat = habitat)
2026-08-18T22:22:52.8178176Z > fit <- drmTMB(bf(y ~ x + habitat, sigma ~ x), data = dat)
2026-08-18T22:22:52.8178271Z > grid <- prediction_grid(
2026-08-18T22:22:52.8178348Z +   fit,
2026-08-18T22:22:52.8178434Z +   focal = "habitat",
2026-08-18T22:22:52.8178543Z +   at = list(habitat = levels(dat$habitat)),
2026-08-18T22:22:52.8178635Z +   margin = "empirical"
2026-08-18T22:22:52.8178713Z + )
2026-08-18T22:22:52.8178933Z > marginal_parameters(fit, newdata = grid, dpar = c("mu", "sigma"), by = "habitat")
2026-08-18T22:22:52.8179095Z    dpar            component     type habitat  estimate  n   conf.status
2026-08-18T22:22:52.8179241Z 1    mu             location response    reef 0.8777762 48 not_requested
2026-08-18T22:22:52.8179381Z 2    mu             location response    sand 0.1789187 48 not_requested
2026-08-18T22:22:52.8179565Z 3 sigma distributional-scale response    reef 0.5759517 48 not_requested
2026-08-18T22:22:52.8179737Z 4 sigma distributional-scale response    sand 0.5759517 48 not_requested
2026-08-18T22:22:52.8179821Z   interval_source
2026-08-18T22:22:52.8179900Z 1   not_available
2026-08-18T22:22:52.8179983Z 2   not_available
