2026-08-18T22:22:52.8110585Z > ### Name: imputed
2026-08-18T22:22:52.8110730Z > ### Title: Extract fitted missing-predictor summaries
2026-08-18T22:22:52.8110833Z > ### Aliases: imputed imputed.drmTMB
2026-08-18T22:22:52.8110912Z > 
2026-08-18T22:22:52.8110991Z > ### ** Examples
2026-08-18T22:22:52.8111069Z > 
2026-08-18T22:22:52.8111156Z > set.seed(20260532)
2026-08-18T22:22:52.8111232Z > n <- 48
2026-08-18T22:22:52.8111321Z > dat <- data.frame(
2026-08-18T22:22:52.8111444Z +   moisture = seq(-1.5, 1.5, length.out = n),
2026-08-18T22:22:52.8111544Z +   canopy = cos(seq_len(n) / 5)
2026-08-18T22:22:52.8111621Z + )
2026-08-18T22:22:52.8111796Z > dat$body_mass_full <- 0.2 + 0.7 * dat$moisture - 0.2 * dat$canopy +
2026-08-18T22:22:52.8111886Z +   rnorm(n, sd = 0.08)
2026-08-18T22:22:52.8112039Z > dat$growth <- 0.6 + 1.1 * dat$body_mass_full - 0.3 * dat$moisture +
2026-08-18T22:22:52.8112127Z +   rnorm(n, sd = 0.20)
2026-08-18T22:22:52.8112221Z > dat$body_mass <- dat$body_mass_full
2026-08-18T22:22:52.8112331Z > dat$body_mass[c(7, 19, 34, 43)] <- NA_real_
2026-08-18T22:22:52.8112408Z > 
2026-08-18T22:22:52.8112487Z > fit <- drmTMB(
2026-08-18T22:22:52.8112620Z +   bf(growth ~ moisture + mi(body_mass), sigma ~ 1),
2026-08-18T22:22:52.8112707Z +   family = gaussian(),
2026-08-18T22:22:52.8112792Z +   data = dat,
2026-08-18T22:22:52.8112945Z +   impute = list(body_mass = body_mass ~ moisture + canopy),
2026-08-18T22:22:52.8113058Z +   missing = miss_control(predictor = "model")
2026-08-18T22:22:52.8113142Z + )
2026-08-18T22:22:52.8113226Z > imputed(fit)
2026-08-18T22:22:52.8113398Z    variable original_row model_row observed   estimate  std_error
2026-08-18T22:22:52.8113533Z 1 body_mass            7         7    FALSE -0.5977839 0.06694745
2026-08-18T22:22:52.8113661Z 2 body_mass           19        19    FALSE  0.1230898 0.06692573
2026-08-18T22:22:52.8113789Z 3 body_mass           34        34    FALSE  0.4920569 0.06762264
2026-08-18T22:22:52.8113909Z 4 body_mass           43        43    FALSE  1.1676530 0.06729264
2026-08-18T22:22:52.8114011Z             source uncertainty_status
2026-08-18T22:22:52.8114103Z 1 conditional_mode                 ok
2026-08-18T22:22:52.8114196Z 2 conditional_mode                 ok
2026-08-18T22:22:52.8114288Z 3 conditional_mode                 ok
2026-08-18T22:22:52.8114377Z 4 conditional_mode                 ok
