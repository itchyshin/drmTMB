2026-08-18T21:56:03.5788527Z             old$encoding <- enc
2026-08-18T21:56:03.5788754Z         family <- family$metrics
2026-08-18T21:56:03.5788968Z     }
2026-08-18T21:56:03.5789192Z     if (is.null(old$encoding) || old$encoding == "default") 
