2026-08-18T21:56:03.5786337Z     old <- check.options(new, name.opt = ".PDF.Options", envir = .PSenv)
2026-08-18T21:56:03.5786766Z     if (!missing(family) && (inherits(family, "Type1Font") || 
2026-08-18T21:56:03.5787100Z         inherits(family, "CIDFont"))) {
2026-08-18T21:56:03.5787356Z         enc <- family$encoding
2026-08-18T21:56:03.5787624Z         if (inherits(family, "Type1Font") && !is.null(enc) && 
2026-08-18T21:56:03.5787994Z             enc != "default" && (is.null(old$encoding) || old$encoding == 
