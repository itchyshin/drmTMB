2026-08-18T21:56:03.5783577Z     if (!missing(fillOddEven)) 
2026-08-18T21:56:03.5783811Z         new$fillOddEven <- fillOddEven
2026-08-18T21:56:03.5784054Z     if (!missing(compress)) 
