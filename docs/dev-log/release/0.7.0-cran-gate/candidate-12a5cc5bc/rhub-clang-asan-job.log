2026-08-18T15:15:23.2977312Z > ### Name: marginal_parameters
2026-08-18T15:15:23.2977499Z > ### Title: Marginal summaries of predicted distributional parameters
2026-08-18T15:15:23.2977661Z > ### Aliases: marginal_parameters marginal_parameters.drmTMB
2026-08-18T15:15:23.2977741Z > 
2026-08-18T15:15:23.2977822Z > ### ** Examples
2026-08-18T15:15:23.2977892Z > 
2026-08-18T15:15:23.2977979Z > set.seed(20260523)
2026-08-18T15:15:23.2978053Z > n <- 48
2026-08-18T15:15:23.2978149Z > x <- seq(-1.5, 1.5, length.out = n)
2026-08-18T15:15:23.2978292Z > habitat <- factor(rep(c("reef", "sand"), length.out = n))
2026-08-18T15:15:23.2978430Z > eta <- 0.4 + 0.7 * x + ifelse(habitat == "reef", 0.25, -0.15)
2026-08-18T15:15:23.2978526Z > sigma <- exp(-0.35 + 0.15 * x)
2026-08-18T15:15:23.2978714Z > dat <- data.frame(y = eta + rnorm(n, sd = sigma), x = x, habitat = habitat)
2026-08-18T15:15:23.2978851Z > fit <- drmTMB(bf(y ~ x + habitat, sigma ~ x), data = dat)
2026-08-18T15:15:23.2978938Z > grid <- prediction_grid(
2026-08-18T15:15:23.2979015Z +   fit,
2026-08-18T15:15:23.2979099Z +   focal = "habitat",
2026-08-18T15:15:23.2979206Z +   at = list(habitat = levels(dat$habitat)),
2026-08-18T15:15:23.2979295Z +   margin = "empirical"
2026-08-18T15:15:23.2979366Z + )
2026-08-18T15:15:23.2979595Z > marginal_parameters(fit, newdata = grid, dpar = c("mu", "sigma"), by = "habitat")
2026-08-18T15:15:23.2979755Z    dpar            component     type habitat  estimate  n   conf.status
2026-08-18T15:15:23.2979905Z 1    mu             location response    reef 0.8777762 48 not_requested
2026-08-18T15:15:23.2980047Z 2    mu             location response    sand 0.1789187 48 not_requested
2026-08-18T15:15:23.2980230Z 3 sigma distributional-scale response    reef 0.5759517 48 not_requested
2026-08-18T15:15:23.2980420Z 4 sigma distributional-scale response    sand 0.5759517 48 not_requested
2026-08-18T15:15:23.2980505Z   interval_source
2026-08-18T15:15:23.2980582Z 1   not_available
2026-08-18T15:15:23.2980662Z 2   not_available
2026-08-18T15:15:23.2980737Z 3   not_available
2026-08-18T15:15:23.2980817Z 4   not_available
2026-08-18T15:15:23.2980888Z > 
