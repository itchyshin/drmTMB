2026-08-18T15:15:23.2913151Z > ### Name: imputed
2026-08-18T15:15:23.2913290Z > ### Title: Extract fitted missing-predictor summaries
2026-08-18T15:15:23.2913387Z > ### Aliases: imputed imputed.drmTMB
2026-08-18T15:15:23.2913462Z > 
2026-08-18T15:15:23.2913542Z > ### ** Examples
2026-08-18T15:15:23.2913613Z > 
2026-08-18T15:15:23.2913690Z > set.seed(20260532)
2026-08-18T15:15:23.2913765Z > n <- 48
2026-08-18T15:15:23.2913848Z > dat <- data.frame(
2026-08-18T15:15:23.2913953Z +   moisture = seq(-1.5, 1.5, length.out = n),
2026-08-18T15:15:23.2914044Z +   canopy = cos(seq_len(n) / 5)
2026-08-18T15:15:23.2914113Z + )
2026-08-18T15:15:23.2914284Z > dat$body_mass_full <- 0.2 + 0.7 * dat$moisture - 0.2 * dat$canopy +
2026-08-18T15:15:23.2914372Z +   rnorm(n, sd = 0.08)
2026-08-18T15:15:23.2914533Z > dat$growth <- 0.6 + 1.1 * dat$body_mass_full - 0.3 * dat$moisture +
2026-08-18T15:15:23.2914616Z +   rnorm(n, sd = 0.20)
2026-08-18T15:15:23.2914707Z > dat$body_mass <- dat$body_mass_full
2026-08-18T15:15:23.2914811Z > dat$body_mass[c(7, 19, 34, 43)] <- NA_real_
2026-08-18T15:15:23.2914880Z > 
2026-08-18T15:15:23.2914956Z > fit <- drmTMB(
2026-08-18T15:15:23.2915080Z +   bf(growth ~ moisture + mi(body_mass), sigma ~ 1),
2026-08-18T15:15:23.2915167Z +   family = gaussian(),
2026-08-18T15:15:23.2915244Z +   data = dat,
2026-08-18T15:15:23.2915387Z +   impute = list(body_mass = body_mass ~ moisture + canopy),
2026-08-18T15:15:23.2915500Z +   missing = miss_control(predictor = "model")
2026-08-18T15:15:23.2915568Z + )
2026-08-18T15:15:23.2915649Z > imputed(fit)
2026-08-18T15:15:23.2915815Z    variable original_row model_row observed   estimate  std_error
2026-08-18T15:15:23.2915948Z 1 body_mass            7         7    FALSE -0.5977839 0.06694745
2026-08-18T15:15:23.2916079Z 2 body_mass           19        19    FALSE  0.1230898 0.06692573
2026-08-18T15:15:23.2916200Z 3 body_mass           34        34    FALSE  0.4920569 0.06762264
2026-08-18T15:15:23.2916323Z 4 body_mass           43        43    FALSE  1.1676530 0.06729264
