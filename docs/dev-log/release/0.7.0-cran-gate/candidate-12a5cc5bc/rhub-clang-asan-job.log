2026-08-18T15:15:23.3013919Z +     conf.status = "wald",
2026-08-18T15:15:23.3014008Z +     interval_source = "wald",
2026-08-18T15:15:23.3014079Z +     x = x
2026-08-18T15:15:23.3014156Z +   ),
2026-08-18T15:15:23.3014231Z +   data.frame(
2026-08-18T15:15:23.3014311Z +     dpar = "sigma",
2026-08-18T15:15:23.3014515Z +     type = "response",
2026-08-18T15:15:23.3014600Z +     estimate = 0.55 + 0.08 * x,
2026-08-18T15:15:23.3014684Z +     conf.low = 0.47 + 0.08 * x,
2026-08-18T15:15:23.3014766Z +     conf.high = 0.63 + 0.08 * x,
2026-08-18T15:15:23.3014850Z +     conf.status = "wald",
2026-08-18T15:15:23.3014932Z +     interval_source = "wald",
2026-08-18T15:15:23.3015007Z +     x = x
2026-08-18T15:15:23.3015085Z +   )
2026-08-18T15:15:23.3015154Z + )
2026-08-18T15:15:23.3015288Z > if (requireNamespace("ggplot2", quietly = TRUE)) {
