2026-08-18T15:15:23.3008051Z > pairs <- data.frame(
2026-08-18T15:15:23.3008176Z +   level = c("residual", "group", "phylo", "group"),
2026-08-18T15:15:23.3008346Z +   class = c("residual", "mean-slope", "structured", "scale-scale"),
2026-08-18T15:15:23.3008427Z +   parameter = c(
2026-08-18T15:15:23.3008609Z +     "rho12",
2026-08-18T15:15:23.3008703Z +     "cor((Intercept),x | p | id)",
2026-08-18T15:15:23.3008794Z +     "cor(mu1,mu2 | species)",
2026-08-18T15:15:23.3008886Z +     "cor(sigma1,sigma2 | site)"
2026-08-18T15:15:23.3008957Z +   ),
2026-08-18T15:15:23.3009035Z +   label = c(
2026-08-18T15:15:23.3009116Z +     "Residual\nrho12",
2026-08-18T15:15:23.3009208Z +     "Group\nmean-slope cor",
2026-08-18T15:15:23.3009302Z +     "Phylogenetic\nmu1-mu2",
2026-08-18T15:15:23.3009390Z +     "Group\nsigma block"
2026-08-18T15:15:23.3009464Z +   ),
2026-08-18T15:15:23.3009557Z +   estimate = c(0.25, 0.45, -0.30, 0.12),
2026-08-18T15:15:23.3009662Z +   modelled = c(FALSE, FALSE, FALSE, FALSE),
2026-08-18T15:15:23.3009752Z +   conf.low = c(0.05, 0.10, -0.55, -0.12),
2026-08-18T15:15:23.3009845Z +   conf.high = c(0.43, 0.72, -0.08, 0.34),
2026-08-18T15:15:23.3009941Z +   conf.status = rep("profile", 4),
2026-08-18T15:15:23.3010034Z +   interval_source = rep("profile", 4)
2026-08-18T15:15:23.3010111Z + )
2026-08-18T15:15:23.3010237Z > if (requireNamespace("ggplot2", quietly = TRUE)) {
2026-08-18T15:15:23.3010324Z +   pair_palette <- c(
