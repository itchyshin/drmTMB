2026-08-18T15:15:23.3021657Z > ##D dat <- data.frame(
2026-08-18T15:15:23.3021903Z > ##D   x1 = seq(-1.2, 1.2, length.out = n),
2026-08-18T15:15:23.3022011Z > ##D   x2 = rep(c(-0.5, 0.5), length.out = n)
2026-08-18T15:15:23.3022088Z > ##D )
2026-08-18T15:15:23.3022171Z > ##D z_binary <- rnorm(n)
2026-08-18T15:15:23.3022433Z > ##D eta <- 0.999999 * tanh(-0.1 + 0.4 * dat$x1 - 0.2 * dat$x2)
2026-08-18T15:15:23.3022567Z > ##D z_count <- eta * z_binary + sqrt(1 - eta^2) * rnorm(n)
2026-08-18T15:15:23.3022660Z > ##D dat$binary <- as.integer(
2026-08-18T15:15:23.3022826Z > ##D   z_binary > qnorm(plogis(-0.2 + 0.3 * dat$x1), lower.tail = FALSE)
2026-08-18T15:15:23.3022903Z > ##D )
2026-08-18T15:15:23.3022989Z > ##D dat$count <- qnbinom(
2026-08-18T15:15:23.3023120Z > ##D   pnorm(z_count), mu = exp(0.5 + 0.2 * dat$x2), size = 4
2026-08-18T15:15:23.3023204Z > ##D )
2026-08-18T15:15:23.3023354Z > ##D binary_fit <- drmTMB(bf(mu = binary ~ x1), binomial(), dat)
2026-08-18T15:15:23.3023439Z > ##D count_fit <- drmTMB(
