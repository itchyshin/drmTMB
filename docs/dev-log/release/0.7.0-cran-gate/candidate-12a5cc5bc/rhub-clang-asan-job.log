2026-08-18T15:15:23.2882468Z 
2026-08-18T15:15:23.2882546Z $sigma
2026-08-18T15:15:23.2882726Z (Intercept)           x 
2026-08-18T15:15:23.2882932Z -0.63277067 -0.01385506 
2026-08-18T15:15:23.2883063Z 
2026-08-18T15:15:23.2883143Z > names(coef(fit))
2026-08-18T15:15:23.2883346Z [1] "mu"    "sigma"
2026-08-18T15:15:23.2883559Z > identical(coef(fit), fixef(fit))
2026-08-18T15:15:23.2883799Z [1] TRUE
2026-08-18T15:15:23.2883969Z > 
