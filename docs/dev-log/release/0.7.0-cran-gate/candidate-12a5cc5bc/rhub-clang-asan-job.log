2026-08-18T15:15:23.3010488Z +     phylo = "#009E73",
2026-08-18T15:15:23.3010572Z +     residual = "#0072B2"
2026-08-18T15:15:23.3010642Z +   )
2026-08-18T15:15:23.3010743Z +   plot_corpairs(pairs, label = "label") +
2026-08-18T15:15:23.3010915Z +     ggplot2::scale_colour_manual(values = pair_palette) +
2026-08-18T15:15:23.3011048Z +     ggplot2::scale_fill_manual(values = pair_palette) +
2026-08-18T15:15:23.3011158Z +     ggplot2::theme_minimal(base_size = 11) +
