2026-08-18T15:15:23.3033235Z > 
2026-08-18T15:15:23.3033317Z > set.seed(20260523)
2026-08-18T15:15:23.3033394Z > n <- 48
2026-08-18T15:15:23.3033486Z > x <- seq(-1.5, 1.5, length.out = n)
2026-08-18T15:15:23.3033627Z > habitat <- factor(rep(c("reef", "sand"), length.out = n))
2026-08-18T15:15:23.3033763Z > eta <- 0.4 + 0.7 * x + ifelse(habitat == "reef", 0.25, -0.15)
