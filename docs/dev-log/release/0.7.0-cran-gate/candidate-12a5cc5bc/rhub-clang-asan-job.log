2026-08-18T15:15:23.2826714Z > ### Name: drm_formula
2026-08-18T15:15:23.2827122Z > ### Title: Build a drmTMB formula object
2026-08-18T15:15:23.2827609Z > ### Aliases: drm_formula bf
2026-08-18T15:15:23.2828004Z > 
2026-08-18T15:15:23.2828512Z > ### ** Examples
2026-08-18T15:15:23.2829703Z > 
2026-08-18T15:15:23.2830060Z > drm_formula(y ~ x, sigma ~ z)
2026-08-18T15:15:23.2830319Z <drm_formula>
2026-08-18T15:15:23.2830513Z y ~ x
2026-08-18T15:15:23.2830743Z sigma ~ z
2026-08-18T15:15:23.2831148Z > drm_formula(y ~ x + (1 | id), sigma ~ z, sd(id) ~ x_group)
2026-08-18T15:15:23.2831469Z <drm_formula>
2026-08-18T15:15:23.2831655Z y ~ x + (1 | id)
2026-08-18T15:15:23.2832021Z sigma ~ z
2026-08-18T15:15:23.2832454Z sd(id) ~ x_group
2026-08-18T15:15:23.2832700Z > drm_formula(
2026-08-18T15:15:23.2832906Z +   y ~ x + (1 | id) + (1 | site),
2026-08-18T15:15:23.2833140Z +   sigma ~ z,
2026-08-18T15:15:23.2833326Z +   sd(id) ~ x_group,
2026-08-18T15:15:23.2833655Z +   sd(site) ~ site_type
2026-08-18T15:15:23.2833910Z + )
2026-08-18T15:15:23.2834082Z <drm_formula>
2026-08-18T15:15:23.2834270Z y ~ x + (1 | id) + (1 | site)
2026-08-18T15:15:23.2834494Z sigma ~ z
2026-08-18T15:15:23.2834729Z sd(id) ~ x_group
2026-08-18T15:15:23.2835024Z sd(site) ~ site_type
2026-08-18T15:15:23.2835226Z > drm_formula(
2026-08-18T15:15:23.2835414Z +   mu1 = y1 ~ x1 + x2,
2026-08-18T15:15:23.2835621Z +   mu2 = y2 ~ x1,
2026-08-18T15:15:23.2835809Z +   sigma1 = ~ x1,
2026-08-18T15:15:23.2836148Z +   sigma2 = ~ x2,
2026-08-18T15:15:23.2836347Z +   rho12 = ~ x1 + x2
2026-08-18T15:15:23.2836542Z + )
2026-08-18T15:15:23.2836710Z <drm_formula>
2026-08-18T15:15:23.2836889Z mu1 = y1 ~ x1 + x2
2026-08-18T15:15:23.2837175Z mu2 = y2 ~ x1
2026-08-18T15:15:23.2837429Z sigma1 = ~x1
2026-08-18T15:15:23.2837612Z sigma2 = ~x2
2026-08-18T15:15:23.2837789Z rho12 = ~x1 + x2
2026-08-18T15:15:23.2838077Z > drm_formula(mvbind(y1, y2) ~ x1 + x2, sigma1 = ~ x1, sigma2 = ~ x2)
2026-08-18T15:15:23.2838566Z <drm_formula>
2026-08-18T15:15:23.2838760Z mvbind(y1, y2) ~ x1 + x2
2026-08-18T15:15:23.2838976Z sigma1 = ~x1
2026-08-18T15:15:23.2839154Z sigma2 = ~x2
2026-08-18T15:15:23.2839326Z > 
