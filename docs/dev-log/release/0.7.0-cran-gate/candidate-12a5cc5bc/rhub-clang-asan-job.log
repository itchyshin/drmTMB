2026-08-18T15:15:23.2875631Z > ### Name: fixef
2026-08-18T15:15:23.2875859Z > ### Title: Extract fixed-effect coefficients
2026-08-18T15:15:23.2876165Z > ### Aliases: fixef fixef.drmTMB coef.drmTMB
2026-08-18T15:15:23.2876426Z > 
2026-08-18T15:15:23.2876588Z > ### ** Examples
2026-08-18T15:15:23.2876771Z > 
2026-08-18T15:15:23.2876942Z > set.seed(20260525)
2026-08-18T15:15:23.2877149Z > dat <- data.frame(
2026-08-18T15:15:23.2877536Z +   y = 0.2 + 0.6 * seq(-1, 1, length.out = 24) + rnorm(24, sd = 0.5),
2026-08-18T15:15:23.2877868Z +   x = seq(-1, 1, length.out = 24)
2026-08-18T15:15:23.2878107Z + )
2026-08-18T15:15:23.2878311Z > fit <- drmTMB(bf(y ~ x, sigma ~ x), data = dat)
2026-08-18T15:15:23.2878584Z > 
2026-08-18T15:15:23.2878843Z > # One distributional parameter at a time: a named numeric vector.
2026-08-18T15:15:23.2879184Z > fixef(fit, "mu")
2026-08-18T15:15:23.2879392Z (Intercept)           x 
2026-08-18T15:15:23.2879610Z   0.2280971   0.5919767 
2026-08-18T15:15:23.2879821Z > coef(fit, "sigma")
2026-08-18T15:15:23.2880022Z (Intercept)           x 
