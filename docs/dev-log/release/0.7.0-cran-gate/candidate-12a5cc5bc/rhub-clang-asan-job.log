2026-08-18T15:15:23.2786742Z > ### Name: corpairs
2026-08-18T15:15:23.2786972Z > ### Title: Extract fitted correlation pairs
2026-08-18T15:15:23.2787273Z > ### Aliases: corpairs corpairs.drmTMB
2026-08-18T15:15:23.2787530Z > 
2026-08-18T15:15:23.2787730Z > ### ** Examples
2026-08-18T15:15:23.2787918Z > 
2026-08-18T15:15:23.2788082Z > set.seed(1)
2026-08-18T15:15:23.2788264Z > n <- 40
2026-08-18T15:15:23.2788438Z > x <- rnorm(n)
2026-08-18T15:15:23.2788623Z > z1 <- rnorm(n)
2026-08-18T15:15:23.2788806Z > z2 <- rnorm(n)
2026-08-18T15:15:23.2788993Z > mu1 <- 0.2 + 0.5 * x
2026-08-18T15:15:23.2789206Z > mu2 <- -0.1 + 0.4 * x
2026-08-18T15:15:23.2789421Z > sigma1 <- exp(-0.2 + 0.15 * z1)
2026-08-18T15:15:23.2789665Z > sigma2 <- exp(0.1 - 0.1 * z2)
2026-08-18T15:15:23.2789895Z > rho <- 0.35
2026-08-18T15:15:23.2790081Z > e1 <- rnorm(n)
2026-08-18T15:15:23.2790292Z > e2 <- rho * e1 + sqrt(1 - rho^2) * rnorm(n)
2026-08-18T15:15:23.2790562Z > dat <- data.frame(
2026-08-18T15:15:23.2790777Z +   y1 = mu1 + sigma1 * e1,
2026-08-18T15:15:23.2791001Z +   y2 = mu2 + sigma2 * e2,
2026-08-18T15:15:23.2791212Z +   x = x,
2026-08-18T15:15:23.2791388Z +   z1 = z1,
2026-08-18T15:15:23.2791568Z +   z2 = z2
2026-08-18T15:15:23.2791951Z + )
2026-08-18T15:15:23.2792140Z > fit <- drmTMB(
2026-08-18T15:15:23.2792327Z +   bf(
2026-08-18T15:15:23.2792505Z +     mu1 = y1 ~ x,
2026-08-18T15:15:23.2792695Z +     mu2 = y2 ~ x,
2026-08-18T15:15:23.2792882Z +     sigma1 = ~ z1,
2026-08-18T15:15:23.2793078Z +     sigma2 = ~ z2,
2026-08-18T15:15:23.2793270Z +     rho12 = ~ 1
2026-08-18T15:15:23.2793455Z +   ),
2026-08-18T15:15:23.2793646Z +   family = c(gaussian(), gaussian()),
2026-08-18T15:15:23.2793896Z +   data = dat
2026-08-18T15:15:23.2794080Z + )
2026-08-18T15:15:23.2794256Z > pairs <- corpairs(fit)
2026-08-18T15:15:23.2794473Z > pairs
