2026-08-18T15:10:28.0676085Z > ### Name: imputed
2026-08-18T15:10:28.0676233Z > ### Title: Extract fitted missing-predictor summaries
2026-08-18T15:10:28.0676346Z > ### Aliases: imputed imputed.drmTMB
2026-08-18T15:10:28.0676432Z > 
2026-08-18T15:10:28.0676523Z > ### ** Examples
2026-08-18T15:10:28.0676609Z > 
2026-08-18T15:10:28.0676701Z > set.seed(20260532)
2026-08-18T15:10:28.0676790Z > n <- 48
2026-08-18T15:10:28.0676883Z > dat <- data.frame(
2026-08-18T15:10:28.0677006Z +   moisture = seq(-1.5, 1.5, length.out = n),
2026-08-18T15:10:28.0677109Z +   canopy = cos(seq_len(n) / 5)
2026-08-18T15:10:28.0677196Z + )
2026-08-18T15:10:28.0677385Z > dat$body_mass_full <- 0.2 + 0.7 * dat$moisture - 0.2 * dat$canopy +
2026-08-18T15:10:28.0677477Z +   rnorm(n, sd = 0.08)
2026-08-18T15:10:28.0677644Z > dat$growth <- 0.6 + 1.1 * dat$body_mass_full - 0.3 * dat$moisture +
