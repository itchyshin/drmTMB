2026-08-18T15:10:28.0534948Z > ### Name: corpairs
2026-08-18T15:10:28.0535197Z > ### Title: Extract fitted correlation pairs
2026-08-18T15:10:28.0535680Z > ### Aliases: corpairs corpairs.drmTMB
2026-08-18T15:10:28.0535963Z > 
2026-08-18T15:10:28.0536151Z > ### ** Examples
2026-08-18T15:10:28.0536356Z > 
2026-08-18T15:10:28.0536542Z > set.seed(1)
2026-08-18T15:10:28.0536743Z > n <- 40
2026-08-18T15:10:28.0536937Z > x <- rnorm(n)
2026-08-18T15:10:28.0537146Z > z1 <- rnorm(n)
2026-08-18T15:10:28.0537362Z > z2 <- rnorm(n)
2026-08-18T15:10:28.0537576Z > mu1 <- 0.2 + 0.5 * x
2026-08-18T15:10:28.0537809Z > mu2 <- -0.1 + 0.4 * x
2026-08-18T15:10:28.0538056Z > sigma1 <- exp(-0.2 + 0.15 * z1)
2026-08-18T15:10:28.0538329Z > sigma2 <- exp(0.1 - 0.1 * z2)
2026-08-18T15:10:28.0538575Z > rho <- 0.35
2026-08-18T15:10:28.0538778Z > e1 <- rnorm(n)
2026-08-18T15:10:28.0539021Z > e2 <- rho * e1 + sqrt(1 - rho^2) * rnorm(n)
2026-08-18T15:10:28.0539318Z > dat <- data.frame(
2026-08-18T15:10:28.0539549Z +   y1 = mu1 + sigma1 * e1,
2026-08-18T15:10:28.0539795Z +   y2 = mu2 + sigma2 * e2,
2026-08-18T15:10:28.0540026Z +   x = x,
2026-08-18T15:10:28.0540225Z +   z1 = z1,
2026-08-18T15:10:28.0540573Z +   z2 = z2
2026-08-18T15:10:28.0540765Z + )
2026-08-18T15:10:28.0540960Z > fit <- drmTMB(
2026-08-18T15:10:28.0541173Z +   bf(
2026-08-18T15:10:28.0541367Z +     mu1 = y1 ~ x,
2026-08-18T15:10:28.0541578Z +     mu2 = y2 ~ x,
2026-08-18T15:10:28.0541788Z +     sigma1 = ~ z1,
2026-08-18T15:10:28.0542003Z +     sigma2 = ~ z2,
2026-08-18T15:10:28.0542219Z +     rho12 = ~ 1
2026-08-18T15:10:28.0542429Z +   ),
2026-08-18T15:10:28.0542645Z +   family = c(gaussian(), gaussian()),
2026-08-18T15:10:28.0542921Z +   data = dat
2026-08-18T15:10:28.0543123Z + )
2026-08-18T15:10:28.0543326Z > pairs <- corpairs(fit)
2026-08-18T15:10:28.0543564Z > pairs
2026-08-18T15:10:28.0543866Z      level group block from_dpar  to_dpar from_coef to_coef from_response
