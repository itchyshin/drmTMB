2026-08-18T15:10:28.0586952Z <drm_formula>
2026-08-18T15:10:28.0587247Z y ~ x
2026-08-18T15:10:28.0587513Z sigma ~ z
2026-08-18T15:10:28.0587896Z > drm_formula(y ~ x + (1 | id), sigma ~ z, sd(id) ~ x_group)
2026-08-18T15:10:28.0588367Z <drm_formula>
2026-08-18T15:10:28.0588661Z y ~ x + (1 | id)
2026-08-18T15:10:28.0588945Z sigma ~ z
2026-08-18T15:10:28.0589226Z sd(id) ~ x_group
2026-08-18T15:10:28.0589524Z > drm_formula(
2026-08-18T15:10:28.0589842Z +   y ~ x + (1 | id) + (1 | site),
2026-08-18T15:10:28.0590215Z +   sigma ~ z,
2026-08-18T15:10:28.0590526Z +   sd(id) ~ x_group,
2026-08-18T15:10:28.0590869Z +   sd(site) ~ site_type
2026-08-18T15:10:28.0591187Z + )
2026-08-18T15:10:28.0591451Z <drm_formula>
2026-08-18T15:10:28.0591740Z y ~ x + (1 | id) + (1 | site)
2026-08-18T15:10:28.0592128Z sigma ~ z
2026-08-18T15:10:28.0592432Z sd(id) ~ x_group
2026-08-18T15:10:28.0592756Z sd(site) ~ site_type
2026-08-18T15:10:28.0593073Z > drm_formula(
2026-08-18T15:10:28.0593385Z +   mu1 = y1 ~ x1 + x2,
2026-08-18T15:10:28.0593727Z +   mu2 = y2 ~ x1,
2026-08-18T15:10:28.0594038Z +   sigma1 = ~ x1,
2026-08-18T15:10:28.0594343Z +   sigma2 = ~ x2,
2026-08-18T15:10:28.0594669Z +   rho12 = ~ x1 + x2
2026-08-18T15:10:28.0594986Z + )
2026-08-18T15:10:28.0595255Z <drm_formula>
2026-08-18T15:10:28.0595951Z mu1 = y1 ~ x1 + x2
2026-08-18T15:10:28.0596235Z mu2 = y2 ~ x1
2026-08-18T15:10:28.0596510Z sigma1 = ~x1
2026-08-18T15:10:28.0596791Z sigma2 = ~x2
2026-08-18T15:10:28.0597059Z rho12 = ~x1 + x2
2026-08-18T15:10:28.0597487Z > drm_formula(mvbind(y1, y2) ~ x1 + x2, sigma1 = ~ x1, sigma2 = ~ x2)
2026-08-18T15:10:28.0598011Z <drm_formula>
2026-08-18T15:10:28.0598299Z mvbind(y1, y2) ~ x1 + x2
2026-08-18T15:10:28.0598620Z sigma1 = ~x1
2026-08-18T15:10:28.0598892Z sigma2 = ~x2
