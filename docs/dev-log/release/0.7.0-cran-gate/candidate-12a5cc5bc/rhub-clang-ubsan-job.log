2026-08-18T15:10:28.0400521Z > 
2026-08-18T15:10:28.0400742Z > set.seed(20260723)
2026-08-18T15:10:28.0400980Z > dat <- data.frame(x = rnorm(80))
2026-08-18T15:10:28.0401232Z > z_g <- rnorm(80)
2026-08-18T15:10:28.0401471Z > z_b <- 0.35 * z_g + sqrt(1 - 0.35^2) * rnorm(80)
2026-08-18T15:10:28.0401787Z > dat$trait_continuous <- 0.2 + 0.5 * dat$x + z_g
2026-08-18T15:10:28.0402111Z > dat$trait_binary <- as.integer(z_b > qnorm(0.6))
2026-08-18T15:10:28.0402393Z > 
