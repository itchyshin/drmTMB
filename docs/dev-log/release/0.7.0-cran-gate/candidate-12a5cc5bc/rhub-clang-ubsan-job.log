2026-08-18T15:10:28.0845663Z + )
2026-08-18T15:10:28.0845810Z > fit <- drmTMB(bf(y ~ x + (1 | id), sigma ~ 1), data = dat)
2026-08-18T15:10:28.0845922Z > names(ranef(fit))
2026-08-18T15:10:28.0846013Z [1] "mu"
