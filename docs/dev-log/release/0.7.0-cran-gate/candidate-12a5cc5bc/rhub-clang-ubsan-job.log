2026-08-18T15:10:28.0757462Z > ### Name: marginal_parameters
2026-08-18T15:10:28.0757663Z > ### Title: Marginal summaries of predicted distributional parameters
2026-08-18T15:10:28.0757826Z > ### Aliases: marginal_parameters marginal_parameters.drmTMB
2026-08-18T15:10:28.0758046Z > 
2026-08-18T15:10:28.0758141Z > ### ** Examples
2026-08-18T15:10:28.0758224Z > 
2026-08-18T15:10:28.0758318Z > set.seed(20260523)
2026-08-18T15:10:28.0758401Z > n <- 48
2026-08-18T15:10:28.0758509Z > x <- seq(-1.5, 1.5, length.out = n)
2026-08-18T15:10:28.0758669Z > habitat <- factor(rep(c("reef", "sand"), length.out = n))
2026-08-18T15:10:28.0758823Z > eta <- 0.4 + 0.7 * x + ifelse(habitat == "reef", 0.25, -0.15)
2026-08-18T15:10:28.0758929Z > sigma <- exp(-0.35 + 0.15 * x)
2026-08-18T15:10:28.0759126Z > dat <- data.frame(y = eta + rnorm(n, sd = sigma), x = x, habitat = habitat)
2026-08-18T15:10:28.0759274Z > fit <- drmTMB(bf(y ~ x + habitat, sigma ~ x), data = dat)
2026-08-18T15:10:28.0759372Z > grid <- prediction_grid(
2026-08-18T15:10:28.0759460Z +   fit,
2026-08-18T15:10:28.0759555Z +   focal = "habitat",
2026-08-18T15:10:28.0759672Z +   at = list(habitat = levels(dat$habitat)),
2026-08-18T15:10:28.0759771Z +   margin = "empirical"
2026-08-18T15:10:28.0759855Z + )
2026-08-18T15:10:28.0760088Z > marginal_parameters(fit, newdata = grid, dpar = c("mu", "sigma"), by = "habitat")
2026-08-18T15:10:28.0760260Z    dpar            component     type habitat  estimate  n   conf.status
2026-08-18T15:10:28.0760411Z 1    mu             location response    reef 0.8777762 48 not_requested
2026-08-18T15:10:28.0760556Z 2    mu             location response    sand 0.1789187 48 not_requested
2026-08-18T15:10:28.0760742Z 3 sigma distributional-scale response    reef 0.5759517 48 not_requested
2026-08-18T15:10:28.0760926Z 4 sigma distributional-scale response    sand 0.5759517 48 not_requested
2026-08-18T15:10:28.0761018Z   interval_source
2026-08-18T15:10:28.0761108Z 1   not_available
2026-08-18T15:10:28.0761197Z 2   not_available
2026-08-18T15:10:28.0761282Z 3   not_available
2026-08-18T15:10:28.0761370Z 4   not_available
