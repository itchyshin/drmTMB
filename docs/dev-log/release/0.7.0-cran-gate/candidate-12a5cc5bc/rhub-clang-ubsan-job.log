2026-08-18T15:10:28.0402843Z +   bf(mu = trait_continuous ~ x, sigma = ~ 1),
2026-08-18T15:10:28.0403148Z +   family = gaussian(), data = dat
2026-08-18T15:10:28.0403403Z + )
2026-08-18T15:10:28.0403593Z > binary_fit <- drmTMB(
