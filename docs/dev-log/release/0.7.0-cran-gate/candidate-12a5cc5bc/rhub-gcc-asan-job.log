2026-08-18T15:51:39.9565099Z y ~ x + (1 | id)
2026-08-18T15:51:39.9565402Z sigma ~ z
2026-08-18T15:51:39.9565702Z sd(id) ~ x_group
2026-08-18T15:51:39.9565973Z > drm_formula(
2026-08-18T15:51:39.9566253Z +   y ~ x + (1 | id) + (1 | site),
2026-08-18T15:51:39.9566601Z +   sigma ~ z,
2026-08-18T15:51:39.9566928Z +   sd(id) ~ x_group,
2026-08-18T15:51:39.9567153Z +   sd(site) ~ site_type
2026-08-18T15:51:39.9567357Z + )
2026-08-18T15:51:39.9567524Z <drm_formula>
