2026-08-18T15:51:39.9779883Z +     "cor((Intercept),x | p | id)",
2026-08-18T15:51:39.9779972Z +     "cor(mu1,mu2 | species)",
2026-08-18T15:51:39.9780066Z +     "cor(sigma1,sigma2 | site)"
2026-08-18T15:51:39.9780138Z +   ),
2026-08-18T15:51:39.9780217Z +   label = c(
2026-08-18T15:51:39.9780303Z +     "Residual\nrho12",
2026-08-18T15:51:39.9780393Z +     "Group\nmean-slope cor",
2026-08-18T15:51:39.9780488Z +     "Phylogenetic\nmu1-mu2",
2026-08-18T15:51:39.9780573Z +     "Group\nsigma block"
2026-08-18T15:51:39.9780648Z +   ),
2026-08-18T15:51:39.9780743Z +   estimate = c(0.25, 0.45, -0.30, 0.12),
2026-08-18T15:51:39.9780861Z +   modelled = c(FALSE, FALSE, FALSE, FALSE),
2026-08-18T15:51:39.9780956Z +   conf.low = c(0.05, 0.10, -0.55, -0.12),
2026-08-18T15:51:39.9781046Z +   conf.high = c(0.43, 0.72, -0.08, 0.34),
2026-08-18T15:51:39.9781145Z +   conf.status = rep("profile", 4),
2026-08-18T15:51:39.9781238Z +   interval_source = rep("profile", 4)
2026-08-18T15:51:39.9781314Z + )
2026-08-18T15:51:39.9781447Z > if (requireNamespace("ggplot2", quietly = TRUE)) {
2026-08-18T15:51:39.9781531Z +   pair_palette <- c(
2026-08-18T15:51:39.9781620Z +     group = "#D55E00",
2026-08-18T15:51:39.9781698Z +     phylo = "#009E73",
