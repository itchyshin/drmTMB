2026-08-18T15:51:39.9505304Z > base::assign(".ptime", proc.time(), pos = "CheckExEnv")
2026-08-18T15:51:39.9505607Z > ### Name: corpairs
2026-08-18T15:51:39.9505835Z > ### Title: Extract fitted correlation pairs
2026-08-18T15:51:39.9506132Z > ### Aliases: corpairs corpairs.drmTMB
2026-08-18T15:51:39.9506384Z > 
2026-08-18T15:51:39.9506547Z > ### ** Examples
2026-08-18T15:51:39.9506725Z > 
2026-08-18T15:51:39.9506888Z > set.seed(1)
2026-08-18T15:51:39.9507068Z > n <- 40
2026-08-18T15:51:39.9507246Z > x <- rnorm(n)
2026-08-18T15:51:39.9507429Z > z1 <- rnorm(n)
2026-08-18T15:51:39.9507611Z > z2 <- rnorm(n)
2026-08-18T15:51:39.9507953Z > mu1 <- 0.2 + 0.5 * x
2026-08-18T15:51:39.9508166Z > mu2 <- -0.1 + 0.4 * x
2026-08-18T15:51:39.9508385Z > sigma1 <- exp(-0.2 + 0.15 * z1)
2026-08-18T15:51:39.9508625Z > sigma2 <- exp(0.1 - 0.1 * z2)
2026-08-18T15:51:39.9508848Z > rho <- 0.35
2026-08-18T15:51:39.9509032Z > e1 <- rnorm(n)
2026-08-18T15:51:39.9509238Z > e2 <- rho * e1 + sqrt(1 - rho^2) * rnorm(n)
2026-08-18T15:51:39.9509508Z > dat <- data.frame(
2026-08-18T15:51:39.9509716Z +   y1 = mu1 + sigma1 * e1,
2026-08-18T15:51:39.9509940Z +   y2 = mu2 + sigma2 * e2,
2026-08-18T15:51:39.9510146Z +   x = x,
2026-08-18T15:51:39.9510318Z +   z1 = z1,
2026-08-18T15:51:39.9510502Z +   z2 = z2
2026-08-18T15:51:39.9510671Z + )
2026-08-18T15:51:39.9510838Z > fit <- drmTMB(
2026-08-18T15:51:39.9511021Z +   bf(
2026-08-18T15:51:39.9511194Z +     mu1 = y1 ~ x,
2026-08-18T15:51:39.9511385Z +     mu2 = y2 ~ x,
2026-08-18T15:51:39.9511572Z +     sigma1 = ~ z1,
2026-08-18T15:51:39.9511772Z +     sigma2 = ~ z2,
2026-08-18T15:51:39.9511969Z +     rho12 = ~ 1
2026-08-18T15:51:39.9512153Z +   ),
2026-08-18T15:51:39.9512343Z +   family = c(gaussian(), gaussian()),
2026-08-18T15:51:39.9512599Z +   data = dat
2026-08-18T15:51:39.9512777Z + )
2026-08-18T15:51:39.9512954Z > pairs <- corpairs(fit)
2026-08-18T15:51:39.9513166Z > pairs
2026-08-18T15:51:39.9513443Z      level group block from_dpar  to_dpar from_coef to_coef from_response
2026-08-18T15:51:39.9513887Z 1 residual  <NA>  <NA>  residual residual      <NA>    <NA>            y1
2026-08-18T15:51:39.9514309Z   to_response    class parameter estimate      min      max n_values
2026-08-18T15:51:39.9514700Z 1          y2 residual     rho12 0.619665 0.619665 0.619665       40
2026-08-18T15:51:39.9515114Z   link_estimate  link_min  link_max modelled   conf.status interval_source
2026-08-18T15:51:39.9515564Z 1     0.7244622 0.7244622 0.7244622    FALSE not_requested   not_available
2026-08-18T15:51:39.9515913Z > corpairs(fit, level = "residual")
2026-08-18T15:51:39.9516260Z      level group block from_dpar  to_dpar from_coef to_coef from_response
2026-08-18T15:51:39.9516687Z 1 residual  <NA>  <NA>  residual residual      <NA>    <NA>            y1
2026-08-18T15:51:39.9517102Z   to_response    class parameter estimate      min      max n_values
2026-08-18T15:51:39.9517482Z 1          y2 residual     rho12 0.619665 0.619665 0.619665       40
2026-08-18T15:51:39.9518004Z   link_estimate  link_min  link_max modelled   conf.status interval_source
2026-08-18T15:51:39.9518439Z 1     0.7244622 0.7244622 0.7244622    FALSE not_requested   not_available
2026-08-18T15:51:39.9518767Z > 
2026-08-18T15:51:39.9519147Z > # Profile intervals are opt-in and can be slow for large models.
2026-08-18T15:51:39.9519535Z > # corpairs(fit, level = "residual", conf.int = TRUE)
2026-08-18T15:51:39.9519821Z > 
2026-08-18T15:51:39.9519981Z > 
