2026-08-18T15:51:39.9583049Z > 
2026-08-18T15:51:39.9583548Z > # Penalised-complexity prior: a priori P(phylogenetic SD > 1) = 0.05.
2026-08-18T15:51:39.9584300Z > pen <- drm_phylo_penalty(sd_u = 1, sd_alpha = 0.05)
2026-08-18T15:51:39.9584820Z > pen$rate
2026-08-18T15:51:39.9585123Z [1] 2.995732
2026-08-18T15:51:39.9585416Z > 
2026-08-18T15:51:39.9585938Z > # Also penalize the phylogenetic correlation in a coupled location-scale or
2026-08-18T15:51:39.9586657Z > # bivariate phylogenetic model.
2026-08-18T15:51:39.9587240Z > pen_cor <- drm_phylo_penalty(sd_u = 1, sd_alpha = 0.05, cor_sd = 0.5)
2026-08-18T15:51:39.9588020Z > pen_cor$cor_sd
2026-08-18T15:51:39.9588332Z [1] 0.5
2026-08-18T15:51:39.9588609Z > 
