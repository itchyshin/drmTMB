2026-08-18T15:51:39.9661252Z > ### Name: imputed
2026-08-18T15:51:39.9661522Z > ### Title: Extract fitted missing-predictor summaries
2026-08-18T15:51:39.9661627Z > ### Aliases: imputed imputed.drmTMB
2026-08-18T15:51:39.9661702Z > 
2026-08-18T15:51:39.9661778Z > ### ** Examples
2026-08-18T15:51:39.9661854Z > 
2026-08-18T15:51:39.9661938Z > set.seed(20260532)
2026-08-18T15:51:39.9662010Z > n <- 48
2026-08-18T15:51:39.9662094Z > dat <- data.frame(
2026-08-18T15:51:39.9662202Z +   moisture = seq(-1.5, 1.5, length.out = n),
2026-08-18T15:51:39.9662297Z +   canopy = cos(seq_len(n) / 5)
2026-08-18T15:51:39.9662474Z + )
2026-08-18T15:51:39.9662659Z > dat$body_mass_full <- 0.2 + 0.7 * dat$moisture - 0.2 * dat$canopy +
2026-08-18T15:51:39.9662749Z +   rnorm(n, sd = 0.08)
2026-08-18T15:51:39.9662909Z > dat$growth <- 0.6 + 1.1 * dat$body_mass_full - 0.3 * dat$moisture +
2026-08-18T15:51:39.9662994Z +   rnorm(n, sd = 0.20)
2026-08-18T15:51:39.9663087Z > dat$body_mass <- dat$body_mass_full
2026-08-18T15:51:39.9663191Z > dat$body_mass[c(7, 19, 34, 43)] <- NA_real_
2026-08-18T15:51:39.9663269Z > 
2026-08-18T15:51:39.9663345Z > fit <- drmTMB(
2026-08-18T15:51:39.9663479Z +   bf(growth ~ moisture + mi(body_mass), sigma ~ 1),
2026-08-18T15:51:39.9663563Z +   family = gaussian(),
2026-08-18T15:51:39.9663644Z +   data = dat,
2026-08-18T15:51:39.9663790Z +   impute = list(body_mass = body_mass ~ moisture + canopy),
2026-08-18T15:51:39.9663908Z +   missing = miss_control(predictor = "model")
2026-08-18T15:51:39.9663982Z + )
2026-08-18T15:51:39.9664059Z > imputed(fit)
