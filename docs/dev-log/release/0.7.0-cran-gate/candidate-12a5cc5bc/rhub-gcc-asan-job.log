2026-08-18T15:51:39.9738576Z > ### Name: marginal_parameters
2026-08-18T15:51:39.9738929Z > ### Title: Marginal summaries of predicted distributional parameters
2026-08-18T15:51:39.9739208Z > ### Aliases: marginal_parameters marginal_parameters.drmTMB
2026-08-18T15:51:39.9739327Z > 
2026-08-18T15:51:39.9739458Z > ### ** Examples
2026-08-18T15:51:39.9739585Z > 
2026-08-18T15:51:39.9739732Z > set.seed(20260523)
2026-08-18T15:51:39.9739861Z > n <- 48
2026-08-18T15:51:39.9740036Z > x <- seq(-1.5, 1.5, length.out = n)
2026-08-18T15:51:39.9740309Z > habitat <- factor(rep(c("reef", "sand"), length.out = n))
2026-08-18T15:51:39.9740568Z > eta <- 0.4 + 0.7 * x + ifelse(habitat == "reef", 0.25, -0.15)
2026-08-18T15:51:39.9740751Z > sigma <- exp(-0.35 + 0.15 * x)
2026-08-18T15:51:39.9741105Z > dat <- data.frame(y = eta + rnorm(n, sd = sigma), x = x, habitat = habitat)
2026-08-18T15:51:39.9741358Z > fit <- drmTMB(bf(y ~ x + habitat, sigma ~ x), data = dat)
2026-08-18T15:51:39.9741521Z > grid <- prediction_grid(
2026-08-18T15:51:39.9741661Z +   fit,
2026-08-18T15:51:39.9741752Z +   focal = "habitat",
2026-08-18T15:51:39.9741871Z +   at = list(habitat = levels(dat$habitat)),
2026-08-18T15:51:39.9742054Z +   margin = "empirical"
2026-08-18T15:51:39.9742362Z + )
2026-08-18T15:51:39.9742610Z > marginal_parameters(fit, newdata = grid, dpar = c("mu", "sigma"), by = "habitat")
2026-08-18T15:51:39.9742774Z    dpar            component     type habitat  estimate  n   conf.status
2026-08-18T15:51:39.9742926Z 1    mu             location response    reef 0.8777762 48 not_requested
2026-08-18T15:51:39.9743127Z 2    mu             location response    sand 0.1789187 48 not_requested
2026-08-18T15:51:39.9743494Z 3 sigma distributional-scale response    reef 0.5759517 48 not_requested
2026-08-18T15:51:39.9744076Z 4 sigma distributional-scale response    sand 0.5759517 48 not_requested
2026-08-18T15:51:39.9744236Z   interval_source
2026-08-18T15:51:39.9744396Z 1   not_available
2026-08-18T15:51:39.9744552Z 2   not_available
2026-08-18T15:51:39.9744698Z 3   not_available
2026-08-18T15:51:39.9744847Z 4   not_available
2026-08-18T15:51:39.9744982Z > 
