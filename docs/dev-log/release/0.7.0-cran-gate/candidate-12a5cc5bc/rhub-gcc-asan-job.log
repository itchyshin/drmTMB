2026-08-18T15:51:39.9842161Z > 
2026-08-18T15:51:39.9842229Z > bf(
2026-08-18T15:51:39.9842323Z +   mu1 = y1 ~ x + (1 | p | id),
2026-08-18T15:51:39.9842404Z +   mu2 = y2 ~ x + (1 | p | id),
2026-08-18T15:51:39.9842485Z +   sd1(id) ~ habitat,
2026-08-18T15:51:39.9842560Z +   sd2(id) ~ habitat,
2026-08-18T15:51:39.9842639Z +   rho12 = ~ x
2026-08-18T15:51:39.9842712Z + )
2026-08-18T15:51:39.9842787Z <drm_formula>
2026-08-18T15:51:39.9842871Z mu1 = y1 ~ x + (1 | p | id)
2026-08-18T15:51:39.9842950Z mu2 = y2 ~ x + (1 | p | id)
2026-08-18T15:51:39.9843028Z sd1(id) ~ habitat
2026-08-18T15:51:39.9843107Z sd2(id) ~ habitat
2026-08-18T15:51:39.9843182Z rho12 = ~x
