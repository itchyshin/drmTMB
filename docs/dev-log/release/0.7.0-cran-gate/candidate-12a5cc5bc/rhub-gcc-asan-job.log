2026-08-18T15:51:39.9593494Z > ### * drm_phylo_penalty_sweep
2026-08-18T15:51:39.9593864Z > 
2026-08-18T15:51:39.9594164Z > flush(stderr()); flush(stdout())
2026-08-18T15:51:39.9594548Z > 
2026-08-18T15:51:39.9594950Z > base::assign(".ptime", proc.time(), pos = "CheckExEnv")
2026-08-18T15:51:39.9595452Z > ### Name: drm_phylo_penalty_sweep
2026-08-18T15:51:39.9596079Z > ### Title: Prior-sensitivity sweep for the phylogenetic correlation penalty
2026-08-18T15:51:39.9596783Z > ### Aliases: drm_phylo_penalty_sweep
2026-08-18T15:51:39.9597210Z > 
2026-08-18T15:51:39.9597503Z > ### ** Examples
2026-08-18T15:51:39.9597962Z > 
2026-08-18T15:51:39.9598249Z > ## No test: 
2026-08-18T15:51:39.9598631Z > if (requireNamespace("ape", quietly = TRUE)) {
2026-08-18T15:51:39.9599125Z +   set.seed(20260601)
2026-08-18T15:51:39.9599473Z +   n_tip <- 10
2026-08-18T15:51:39.9599815Z +   tree <- ape::rcoal(n_tip)
2026-08-18T15:51:39.9600281Z +   tree$tip.label <- paste0("sp_", seq_len(n_tip))
2026-08-18T15:51:39.9600813Z +   A <- ape::vcv(tree, corr = TRUE)
2026-08-18T15:51:39.9601301Z +   u <- as.vector(t(chol(A)) %*% rnorm(n_tip)) * 0.6
2026-08-18T15:51:39.9601987Z +   species <- factor(rep(tree$tip.label, each = 2), levels = tree$tip.label)
2026-08-18T15:51:39.9602639Z +   x <- rnorm(length(species))
2026-08-18T15:51:39.9603040Z +   dat <- data.frame(
2026-08-18T15:51:39.9603465Z +     y = 0.3 + 0.5 * x + u[rep(seq_len(n_tip), each = 2)] +
2026-08-18T15:51:39.9603999Z +       rnorm(length(species), sd = 0.5),
2026-08-18T15:51:39.9604654Z +     x = x,
2026-08-18T15:51:39.9604979Z +     species = species
2026-08-18T15:51:39.9605323Z +   )
2026-08-18T15:51:39.9605604Z + 
2026-08-18T15:51:39.9606094Z +   # A coupled location-scale phylo model has two phylogenetic SDs, so the
2026-08-18T15:51:39.9606842Z +   # cor_sd sweep is informative (see drm_phylo_penalty()).
2026-08-18T15:51:39.9607004Z +   out <- drm_phylo_penalty_sweep(
2026-08-18T15:51:39.9607127Z +     bf(
2026-08-18T15:51:39.9607303Z +       y ~ x + phylo(1 | species, tree = tree),
2026-08-18T15:51:39.9608111Z +       sigma ~ phylo(1 | species, tree = tree)
2026-08-18T15:51:39.9608272Z +     ),
2026-08-18T15:51:39.9608474Z +     data = dat,
2026-08-18T15:51:39.9608742Z +     family = gaussian(),
2026-08-18T15:51:39.9608979Z +     cor_sd = c(0.5, 1)
2026-08-18T15:51:39.9609202Z +   )
2026-08-18T15:51:39.9609422Z +   out$summary
2026-08-18T15:51:39.9609607Z + }
2026-08-18T15:51:39.9609817Z   cor_sd convergence pdHess    logLik error
2026-08-18T15:51:39.9610012Z 1    0.5           0   TRUE -12.67648  <NA>
2026-08-18T15:51:39.9610187Z 2    1.0           0   TRUE -12.62536  <NA>
2026-08-18T15:51:39.9610354Z > ## End(No test)
2026-08-18T15:51:39.9610515Z > 
2026-08-18T15:51:39.9610665Z > 
