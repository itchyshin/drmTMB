2026-11-07T02:22:26.9110347Z > library(testthat)
2026-11-07T02:22:26.9110732Z > library(drmTMB)
2026-11-07T02:22:26.9111064Z > 
2026-11-07T02:22:26.9111759Z > # The complete suite is an evidence programme as well as a package test suite:
2026-11-07T02:22:26.9112836Z > # it includes simulation, recovery, coverage, numerical-oracle, comparator,
2026-11-07T02:22:26.9113678Z > # generated-contract, and reader-render audits. Keep all of it in repository CI,
2026-11-07T02:22:26.9114570Z > # but run a bounded installed-package smoke lane during routine CRAN checks.
2026-11-07T02:22:26.9115247Z > #
2026-11-07T02:22:26.9115929Z > # Candidate 6b45164b took 14 minutes in the Windows test stage even after the
2026-11-07T02:22:26.9117545Z > # existing validation-suite exclusions. An explicit allowlist is fail-closed:
2026-11-07T02:22:26.9118619Z > # a new evidence suite runs in full CI by default and enters the CRAN lane only
2026-11-07T02:22:26.9119459Z > # after its runtime and purpose are reviewed.
2026-11-07T02:22:26.9119934Z > #
2026-11-07T02:22:26.9120589Z > # The retained contexts cover release identity, formula parsing, ordinary
2026-11-07T02:22:26.9121610Z > # families, representative structured/missing/meta routes, public methods,
2026-11-07T02:22:26.9122684Z > # MSPL, and reader/S3 compatibility. Nothing is deleted or weakened. Julia
2026-11-07T02:22:26.9123750Z > # remains defense-in-depth blocked in the CRAN lane by drm_julia_setup() unless
2026-11-07T02:22:26.9124785Z > # DRMTMB_JULIA_TESTS=true; its live suite remains repository-CI-only.
2026-11-07T02:22:26.9125829Z > # Repository CI shards the full suite across parallel jobs via DRMTMB_TEST_SHARD
2026-11-07T02:22:26.9127160Z > # ("k/N"); unset means run everything, so a local devtools::test() is unchanged.
2026-11-07T02:22:26.9128220Z > # The helper lives under testthat/ so R CMD check does not execute it as a test
2026-11-07T02:22:26.9129276Z > # file in its own right, and is sourced here the same way helper-cran-lane.R is
2026-11-07T02:22:26.9130312Z > # below -- it is needed BEFORE test_check(), to build the filter argument.
2026-11-07T02:22:26.9131372Z > # The CRAN lane is deliberately never sharded: it is already a bounded allowlist.
2026-11-07T02:22:26.9132515Z > source(file.path("testthat", "helper-shard-util.R"), local = TRUE)
2026-11-07T02:22:26.9133091Z > drm_shard <- drm_shard_filter()
2026-11-07T02:22:26.9133521Z > 
2026-11-07T02:22:26.9134091Z > not_cran <- isTRUE(as.logical(Sys.getenv("NOT_CRAN", "false")))
2026-11-07T02:22:26.9134543Z > if (not_cran) {
2026-11-07T02:22:26.9134848Z +   if (is.null(drm_shard)) {
