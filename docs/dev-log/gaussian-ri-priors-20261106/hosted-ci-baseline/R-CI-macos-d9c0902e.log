2026-11-07T01:36:35.0981400Z > library(testthat)
2026-11-07T01:36:35.0982140Z > library(drmTMB)
2026-11-07T01:36:35.0982690Z > 
2026-11-07T01:36:35.0983820Z > # The complete suite is an evidence programme as well as a package test suite:
2026-11-07T01:36:35.0986900Z > # it includes simulation, recovery, coverage, numerical-oracle, comparator,
2026-11-07T01:36:35.0988630Z > # generated-contract, and reader-render audits. Keep all of it in repository CI,
2026-11-07T01:36:35.0990260Z > # but run a bounded installed-package smoke lane during routine CRAN checks.
2026-11-07T01:36:35.0991150Z > #
2026-11-07T01:36:35.0992180Z > # Candidate 6b45164b took 14 minutes in the Windows test stage even after the
2026-11-07T01:36:35.0993680Z > # existing validation-suite exclusions. An explicit allowlist is fail-closed:
2026-11-07T01:36:35.0995200Z > # a new evidence suite runs in full CI by default and enters the CRAN lane only
2026-11-07T01:36:35.0996540Z > # after its runtime and purpose are reviewed.
2026-11-07T01:36:35.0997250Z > #
2026-11-07T01:36:35.0998380Z > # The retained contexts cover release identity, formula parsing, ordinary
2026-11-07T01:36:35.1010780Z > # families, representative structured/missing/meta routes, public methods,
2026-11-07T01:36:35.1011780Z > # MSPL, and reader/S3 compatibility. Nothing is deleted or weakened. Julia
2026-11-07T01:36:35.1012460Z > # remains defense-in-depth blocked in the CRAN lane by drm_julia_setup() unless
2026-11-07T01:36:35.1013020Z > # DRMTMB_JULIA_TESTS=true; its live suite remains repository-CI-only.
2026-11-07T01:36:35.1013700Z > # Repository CI shards the full suite across parallel jobs via DRMTMB_TEST_SHARD
2026-11-07T01:36:35.1014460Z > # ("k/N"); unset means run everything, so a local devtools::test() is unchanged.
2026-11-07T01:36:35.1014990Z > # The helper lives under testthat/ so R CMD check does not execute it as a test
2026-11-07T01:36:35.1016680Z > # file in its own right, and is sourced here the same way helper-cran-lane.R is
2026-11-07T01:36:35.1017230Z > # below -- it is needed BEFORE test_check(), to build the filter argument.
2026-11-07T01:36:35.1017890Z > # The CRAN lane is deliberately never sharded: it is already a bounded allowlist.
2026-11-07T01:36:35.1019030Z > source(file.path("testthat", "helper-shard-util.R"), local = TRUE)
2026-11-07T01:36:35.1019600Z > drm_shard <- drm_shard_filter()
2026-11-07T01:36:35.1019930Z > 
2026-11-07T01:36:35.1020330Z > not_cran <- isTRUE(as.logical(Sys.getenv("NOT_CRAN", "false")))
2026-11-07T01:36:35.1020800Z > if (not_cran) {
2026-11-07T01:36:35.1021090Z +   if (is.null(drm_shard)) {
2026-11-07T01:36:35.1021420Z +     test_check("drmTMB")
2026-11-07T01:36:35.1021670Z +   } else {
2026-11-07T01:36:35.1022060Z +     test_check("drmTMB", filter = drm_shard)
2026-11-07T01:36:35.1022370Z +   }
2026-11-07T01:36:35.1022690Z + } else {
2026-11-07T01:36:35.1023010Z +   source(file.path("testthat", "helper-cran-lane.R"), local = TRUE)
2026-11-07T01:36:35.1023400Z +   test_check(
2026-11-07T01:36:35.1023710Z +     "drmTMB",
2026-11-07T01:36:35.1024010Z +     filter = drm_cran_test_filter()
2026-11-07T01:36:35.1024280Z +   )
2026-11-07T01:36:35.1024450Z + }
