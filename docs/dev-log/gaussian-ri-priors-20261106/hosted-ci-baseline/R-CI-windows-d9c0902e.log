2026-11-07T01:30:19.1341846Z > library(testthat)
2026-11-07T01:30:19.1342134Z > library(drmTMB)
2026-11-07T01:30:19.1342414Z > 
2026-11-07T01:30:19.1342829Z > # The complete suite is an evidence programme as well as a package test suite:
2026-11-07T01:30:19.1344083Z > # it includes simulation, recovery, coverage, numerical-oracle, comparator,
2026-11-07T01:30:19.1344618Z > # generated-contract, and reader-render audits. Keep all of it in repository CI,
2026-11-07T01:30:19.1345185Z > # but run a bounded installed-package smoke lane during routine CRAN checks.
2026-11-07T01:30:19.1345551Z > #
2026-11-07T01:30:19.1345935Z > # Candidate 6b45164b took 14 minutes in the Windows test stage even after the
2026-11-07T01:30:19.1346479Z > # existing validation-suite exclusions. An explicit allowlist is fail-closed:
2026-11-07T01:30:19.1347227Z > # a new evidence suite runs in full CI by default and enters the CRAN lane only
2026-11-07T01:30:19.1347800Z > # after its runtime and purpose are reviewed.
2026-11-07T01:30:19.1348082Z > #
2026-11-07T01:30:19.1348422Z > # The retained contexts cover release identity, formula parsing, ordinary
2026-11-07T01:30:19.1348913Z > # families, representative structured/missing/meta routes, public methods,
2026-11-07T01:30:19.1349377Z > # MSPL, and reader/S3 compatibility. Nothing is deleted or weakened. Julia
2026-11-07T01:30:19.1349863Z > # remains defense-in-depth blocked in the CRAN lane by drm_julia_setup() unless
2026-11-07T01:30:19.1350664Z > # DRMTMB_JULIA_TESTS=true; its live suite remains repository-CI-only.
2026-11-07T01:30:19.1351267Z > # Repository CI shards the full suite across parallel jobs via DRMTMB_TEST_SHARD
2026-11-07T01:30:19.1351857Z > # ("k/N"); unset means run everything, so a local devtools::test() is unchanged.
2026-11-07T01:30:19.1352369Z > # The helper lives under testthat/ so R CMD check does not execute it as a test
2026-11-07T01:30:19.1352918Z > # file in its own right, and is sourced here the same way helper-cran-lane.R is
2026-11-07T01:30:19.1353407Z > # below -- it is needed BEFORE test_check(), to build the filter argument.
2026-11-07T01:30:19.1353919Z > # The CRAN lane is deliberately never sharded: it is already a bounded allowlist.
2026-11-07T01:30:19.1354416Z > source(file.path("testthat", "helper-shard-util.R"), local = TRUE)
2026-11-07T01:30:19.1354786Z > drm_shard <- drm_shard_filter()
2026-11-07T01:30:19.1355007Z > 
2026-11-07T01:30:19.1355523Z > not_cran <- isTRUE(as.logical(Sys.getenv("NOT_CRAN", "false")))
2026-11-07T01:30:19.1356071Z > if (not_cran) {
2026-11-07T01:30:19.1356304Z +   if (is.null(drm_shard)) {
